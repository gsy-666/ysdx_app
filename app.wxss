/** app.wxss **/
page {
  /* Cool Medical Blue Theme */
  --bg-color: #F0F4F7;
  --card-bg: #FFFFFF;
  --primary-color: #3B99FC; 
  --primary-gradient: linear-gradient(90deg, #56CCF2 0%, #2F80ED 100%);
  --secondary-color: #D4A073; 
  --text-main: #1F3A56; 
  --text-sub: #64748B;
  --border-color: #E6EEF5;
  --shadow-color: rgba(31, 58, 86, 0.08);

  background-color: var(--bg-color);
  color: var(--text-main);
  background-image: none;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica;
  height: 100%;
}

.glass-card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
  border-radius: 20rpx;
  color: var(--text-main);
}
