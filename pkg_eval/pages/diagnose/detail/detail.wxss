page {
  background-color: #F4F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1A1A1A;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 600rpx;
  background: linear-gradient(180deg, #E6F0FF 0%, #F4F7FA 100%);
  z-index: -1;
  overflow: hidden;
}

.page-bg::after {
  content: "";
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 350rpx;
  height: 350rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(59,153,252,0.12) 0%, rgba(59,153,252,0) 70%);
}

.page-bg::before {
  content: "";
  position: absolute;
  top: 180rpx;
  left: -100rpx;
  width: 450rpx;
  height: 450rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(26,125,249,0.08) 0%, rgba(26,125,249,0) 70%);
}

.container {
  padding: 30rpx 40rpx;
  position: relative;
  z-index: 1;
}



.header {

  margin-bottom: 40rpx;

}



.title {

  font-size: 48rpx;

  font-weight: 700;

  color: #1A2233;

}



/* Info Cards */

.intro-card {

  background: #FFFFFF;

  border-radius: 24rpx;

  padding: 40rpx;

  margin-bottom: 30rpx;

  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);

}



.intro-header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 20rpx;

}



.intro-title {

  font-size: 34rpx;

  font-weight: 600;

  color: #1A2233;

}



.risk-badge {

  padding: 6rpx 20rpx;

  border-radius: 40rpx;

  font-size: 24rpx;

  font-weight: 600;

}



.risk-badge.low {

  background: #EAF7EC;

  color: #279A4B;

}



.risk-badge.medium {

  background: #FFF4E5;

  color: #DDAA33;

}



.risk-badge.high {

  background: #FFECEE;

  color: #E64359;

}



.intro-desc {

  font-size: 28rpx;

  color: #728299;

  line-height: 1.6;

}



.intro-tags {

  display: flex;

  flex-wrap: wrap;

  gap: 16rpx;

  margin-top: 30rpx;

}



.tag {

  background: #F0F6FF;

  color: #3B99FC;

  font-size: 26rpx;

  padding: 10rpx 26rpx;

  border-radius: 12rpx;

  font-weight: 500;

}



/* Forms & Data Entry Cards */

.card {

  background: #FFFFFF;

  border-radius: 24rpx;

  padding: 40rpx;

  margin-bottom: 30rpx;

  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);

}



.card-title {

  font-size: 34rpx;

  font-weight: 600;

  color: #3B99FC;

  margin-bottom: 40rpx;

}



.form-item {

  margin-bottom: 36rpx;

}



.form-item:last-child {

  margin-bottom: 0;

}



.form-item.row-space {

  display: flex;

  justify-content: space-between;

  align-items: center;

}



.form-item text,

.label {

  font-size: 30rpx;

  color: #495466;

  font-weight: 500;

  margin-bottom: 16rpx;

  display: block;

}



.form-item.row-space text {

  margin-bottom: 0;

}



.input,

.picker-input {

  background: #F8FAFC;

  padding: 24rpx 32rpx;

  border-radius: 16rpx;

  font-size: 30rpx;

  color: #1A2233;

}



.picker-input {

  min-height: 40rpx;

}



/* Switches Switch Styles override for premium feel via WXML switch color */

switch {

  transform: scale(0.9);

}



wx-switch .wx-switch-input {

  background-color: #E2E8F0 !important;

  border: none !important;

}



wx-switch .wx-switch-input.wx-switch-input-checked {

  background-color: #3B99FC !important;

}

/* Submit Button */

.submit-btn {

  width: 100% !important;

  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);

  color: #FFFFFF;

  border-radius: 44rpx;

  font-weight: 600;

  font-size: 34rpx;

  padding: 24rpx 0;

  margin-top: 60rpx;

  margin-bottom: 40rpx;

  box-shadow: 0 12rpx 28rpx rgba(59, 153, 252, 0.3);

  text-align: center;

  border: none;

}

.submit-btn::after {

  display: none;

}

.submit-btn:active {

  transform: scale(0.98);

  opacity: 0.9;

}

/* Unstyled classes found in wxml */

.system-row {

  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 24rpx;

}

.system-label {

  font-size: 30rpx;

  color: #495466;

  font-weight: 500;

}

.system-ctrl {

  background: #F8FAFC;

  padding: 8rpx 16rpx;

  border-radius: 12rpx;

}

.textarea {

  background: #F8FAFC;

  width: 100%;

  padding: 24rpx 32rpx;

  border-radius: 16rpx;

  font-size: 30rpx;

  color: #1A2233;

  box-sizing: border-box;

  min-height: 160rpx;

}

.add-btn {

  font-size: 28rpx;

  color: #3B99FC;

  float: right;

  font-weight: normal;

}

.med-item {

  display: flex;

  gap: 20rpx;

  margin-bottom: 20rpx;

}

.empty-tip {

  text-align: center;

  color: #99A4B5;

  font-size: 28rpx;

  padding: 20rpx 0;

}

/* Menu Cards */

.menu-card {

  display: flex;

  background: #F8FAFC;

  border-radius: 20rpx;

  padding: 30rpx;

  margin-bottom: 24rpx;

  align-items: center;

  transition: all 0.2s ease;

}

.menu-card:active {

  transform: scale(0.98);

  background: #F0F4F8;

}

.icon-box {

  width: 96rpx;

  height: 96rpx;

  border-radius: 24rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  margin-right: 30rpx;

  flex-shrink: 0;

}

.icon-text {

  font-size: 28rpx;

  font-weight: 600;

  color: #1A2233;

}

.content {

  flex: 1;

}

.ct-title {

  font-size: 32rpx;

  font-weight: 600;

  color: #1A2233;

  margin-bottom: 12rpx;

}

.ct-desc {

  font-size: 26rpx;

  color: #728299;

  line-height: 1.4;

}
.intro-tips { margin-top: 20rpx; background: #fff8e1; color: #f57c00; font-size: 26rpx; padding: 20rpx; border-radius: 12rpx; }
.tips-title { font-weight: bold; margin-bottom: 6rpx; }
.tips-content { line-height: 1.5; }
.intro-eval { margin-top: 20rpx; font-size: 26rpx; color: #2F80ED; border-top: 1rpx dashed #eee; padding-top: 20rpx; }
.eval-title { font-weight: bold; color: #333; }
