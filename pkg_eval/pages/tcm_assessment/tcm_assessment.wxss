page {
  min-height: 100vh;
  background: linear-gradient(180deg, #8ccbff 0%, #cbedff 15%, #F8FCFF 30%);
  background-color: #F8FCFF;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', sans-serif;
  overflow-x: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
  display: flex;
  flex-direction: column;
}

/* === Top Section === */
.top-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
  padding-bottom: 20rpx;
  width: 100%;
}

.nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

/* Clean up Avatar */
.avatar-ring-wrapper {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.2) 100%);
  box-shadow: 0 10rpx 40rpx rgba(140, 203, 255, 0.4);
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(4px);
}

.avatar-img {
  width: 90%;
  height: 90%;
  border-radius: 50%;
  z-index: 2;
}

.hud-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.hud-ring-ticks {
  position: absolute;
  top: -16rpx; left: -16rpx; right: -16rpx; bottom: -16rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(59, 153, 252, 0.2);
  animation: spin-slow 40s linear infinite;
}

.hud-arc-glow {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  box-shadow: inset 0 0 40rpx rgba(59, 153, 252, 0.1);
}

/* Stats overlay */
.hud-text-center {
  position: absolute;
  bottom: -30rpx;
  background: #FFFFFF;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hud-lbl-top, .hud-lbl-bottom {
  font-size: 24rpx;
  color: #64748B;
  font-weight: 500;
}

.hud-score-box {
  display: flex;
  align-items: baseline;
  padding: 0 10rpx;
}

.hud-score-num {
  font-family: din-bold, 'Impact', sans-serif;
  font-size: 44rpx;
  color: #3B99FC;
  font-weight: bold;
}

.hud-score-unit {
  font-size: 24rpx;
  color: #3B99FC;
  margin-left: 4rpx;
  font-weight: bold;
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* === 4 Grid === */
.grid-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
}

.grid-item {
  width: 47.5%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: all 0.2s;
  box-sizing: border-box;
}

.grid-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.item-content {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-sizing: border-box;
}

.grid-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F3A56;
  margin-bottom: 8rpx;
}

.grid-sub {
  font-size: 22rpx;
  color: #94A3B8;
}

.grid-icon {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  font-size: 48rpx;
}

/* === Button === */
.action-section {
  width: 100%;
  margin: 40rpx 0;
  display: flex;
  justify-content: center;
}

.action-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #3B99FC 0%, #0077FF 100%);
  color: #fff;
  font-size: 34rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 24rpx rgba(59, 153, 252, 0.3);
  letter-spacing: 4rpx;
  padding: 0;
}
.action-btn::after {
  border: none;
}

/* === Dashboard (Charts) === */
.dashboard-section {
  display: flex;
  justify-content: space-between;
  width: 100%;
  gap: 20rpx;
  padding-bottom: 30rpx;
}

.dashboard-card {
  width: 48%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  flex-direction: column;
  margin-bottom: 12rpx;
}

.card-title-lg {
  font-size: 30rpx;
  font-weight: bold;
  color: #1F3A56;
  margin-bottom: 4rpx;
}

.card-title-sub {
  font-size: 22rpx;
  color: #94A3B8;
}

.chart-box {
  width: 100%;
  height: 180rpx;
  position: relative !important;
}

/* ec-canvas */
ec-canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx dashed #E2E8F0;
  padding-top: 20rpx;
  margin-top: auto;
}

.footer-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.val {
  font-size: 26rpx;
  font-weight: bold;
  color: #3B99FC;
  margin-bottom: 6rpx;
}

.lbl {
  font-size: 20rpx;
  color: #64748B;
}