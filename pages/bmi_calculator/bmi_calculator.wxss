page {
  background-color: var(--bg-color);
}
.header-bg {
  background: linear-gradient(180deg, #E6F3FB 0%, #F0F4F7 100%);
  height: 200rpx;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}
.main-card {
  margin-top: 40rpx;
  padding-bottom: 60rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
}
.card-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #3B99FC 0%, #1A7DF9 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 30rpx 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.form-group {
  margin-top: 20rpx;
}
.form-item {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F0F4F7;
  padding: 30rpx 0;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-main);
}
.input-box {
  flex: 1;
  font-size: 28rpx;
}
.m-top {
  margin-top: 60rpx;
}
.primary-btn {
  background: linear-gradient(90deg, #3B99FC 0%, #1A7DF9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(26, 125, 249, 0.2);
}
.result-box {
  margin-top: 60rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}
.result-title {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}
.result-value {
  font-size: 64rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}
.result-desc {
  font-size: 28rpx;
  color: var(--text-main);
}

/* 动态颜色控制 */
.text-normal {
  color: var(--primary-color) !important;
}
.text-abnormal {
  color: #FF5A5F !important;
}
