/* pages/patient/detail.wxss */
page {
  background-color: #f9f5f0;
}

.detail-container {
  padding: 30rpx;
  min-height: 100vh;
}

/* User Card */
.user-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #C19D34;
  box-shadow: 0 4rpx 12rpx rgba(193, 157, 52, 0.1);
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #f5e8d5;
  margin-bottom: 20rpx;
  background-color: #FFF8E7;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #C19D34;
  margin-bottom: 10rpx;
}

.info-row {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
}

.tag {
  background-color: #FFF8E7;
  color: #C19D34;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin: 0 10rpx;
  border: 1rpx solid #C19D34;
}

/* Data Grid */
.data-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid #C19D34;
  box-shadow: 0 4rpx 12rpx rgba(193, 157, 52, 0.1);
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 30rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #C19D34;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.data-label {
  font-size: 26rpx;
  color: #a0522d;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* List Style for History */
.list-row {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #d2b48c;
}

.list-row:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.list-label {
  font-size: 28rpx;
  color: #a0522d;
  width: 160rpx;
  flex-shrink: 0;
}

.list-content {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* Actions */
.action-area {
  margin-top: 60rpx;
}

.btn {
  background-color: #C19D34;
  color: #fff;
  margin-bottom: 30rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(193, 157, 52, 0.3);
}

.btn-secondary {
  background-color: #FFF8E7;
  color: #C19D34;
  border: 2rpx solid #C19D34;
  box-shadow: none;
}

.warn-text {
  color: #d9534f;
  font-weight: bold;
}

.highlight {
  color: #C19D34;
  font-weight: bold;
}

.sub-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}
