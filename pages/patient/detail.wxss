/* pages/patient/detail.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.detail-container {
  padding: 30rpx;
  min-height: 100vh;
}

/* User Card */
.user-card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 20rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 30rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border-color);
  margin-bottom: 20rpx;
  background-color: rgba(76, 201, 240, 0.1);
  box-shadow: 0 0 20rpx rgba(76, 201, 240, 0.2);
}

.name {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 10rpx;
  text-shadow: 0 0 8rpx var(--primary-color);
  letter-spacing: 2rpx;
}

.info-row {
  display: flex;
  justify-content: center;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  background-color: rgba(76, 201, 240, 0.1);
  color: var(--primary-color);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 5rpx rgba(76, 201, 240, 0.1);
}

.section-card {
   background: var(--card-bg);
   backdrop-filter: blur(5px);
   border-radius: 16rpx;
   padding: 30rpx;
   margin-bottom: 24rpx;
   border: 1rpx solid var(--border-color);
   color: var(--text-main);
}
