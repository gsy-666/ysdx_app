<!--pages/patient/detail.wxml-->
<view class="detail-container">

  <!-- 基本信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{patient.avatar || '/static/default_avatar.svg'}}" mode="aspectFill"></image>
    <view class="name">{{patient.name || '未命名'}}</view>
    <view class="info-row">
      <text class="tag">{{patient.gender === 1 ? '男' : (patient.gender === 2 ? '女' : '未知')}}</text>
      <text class="tag">{{patient.age || '--'}}岁</text>
      <text class="tag">{{patient.phone || '无电话'}}</text>
    </view>
  </view>

  <!-- 身体数据 -->
  <view class="data-section">
    <view class="section-title">身体数据</view>
    <view class="grid">
      <view class="grid-item">
        <text class="data-label">身高</text>
        <text class="data-value">{{patient.height ? patient.height + ' cm' : '--'}}</text>
      </view>
      <view class="grid-item">
        <text class="data-label">体重</text>
        <text class="data-value">{{patient.weight ? patient.weight + ' kg' : '--'}}</text>
      </view>
      <view class="grid-item">
        <text class="data-label">BMI</text>
        <text class="data-value">{{bmi || '--'}}</text>
      </view>
      <view class="grid-item">
        <text class="data-label">注册时间</text>
        <text class="data-value">{{patient.createTime || '--'}}</text>
      </view>
    </view>
  </view>

  <!-- 中医状态评估数据 -->
  <view class="data-section" wx:if="{{grade}}">
    <view class="section-title">中医状态评估</view>
    <view class="list-row">
      <view class="list-label">评估时间：</view>
      <view class="list-content">{{grade.testDate || '--'}}</view>
    </view>
    <view class="list-row">
      <view class="list-label">主要状态：</view>
      <view class="list-content highlight">{{grade.conc1 || '暂无'}} <text
          wx:if="{{grade.score1}}">({{grade.score1}}分)</text></view>
    </view>
    <view class="list-row" wx:if="{{grade.conc2}}">
      <view class="list-label">兼见状态：</view>
      <view class="list-content">{{grade.conc2}} <text wx:if="{{grade.score2}}">({{grade.score2}}分)</text></view>
    </view>
  </view>

  <!-- 风险预警数据 -->
  <view class="data-section" wx:if="{{screen}}">
    <view class="section-title">风险预警指标</view>

    <!-- 代谢综合征综合评估 -->
    <view class="list-row">
      <view class="list-label">代谢综合征风险：</view>
      <view class="list-content {{screenDisplay.metabolicRisk ? 'warn-text' : ''}}">
        {{screenDisplay.metabolicRisk ? '高风险' : '低风险'}} ({{screenDisplay.metabolicCount}}/5项)
      </view>
    </view>

    <view class="list-row">
      <view class="list-label"> - 腹型肥胖：</view>
      <view class="list-content {{screen.abdominalObesity == 1 ? 'warn-text' : ''}}">
        {{screen.abdominalObesity == 1 ? '是 (高风险)' : '否'}}
      </view>
    </view>
    <view class="list-row">
      <view class="list-label"> - 高血糖风险：</view>
      <view class="list-content {{screen.highBloodSugar == 1 ? 'warn-text' : ''}}">
        {{screen.highBloodSugar == 1 ? '是' : '否'}}
        <text wx:if="{{screen.diabetesType}}" class="sub-text">({{screen.diabetesType}})</text>
      </view>
    </view>
    <view class="list-row">
      <view class="list-label"> - 高血压风险：</view>
      <view class="list-content {{screen.hypertension == 1 ? 'warn-text' : ''}}">
        {{screen.hypertension == 1 ? '是' : '否'}}
        <text wx:if="{{screen.hypertensionType}}" class="sub-text">({{screen.hypertensionType}})</text>
      </view>
    </view>
    <view class="list-row" wx:if="{{screen.highTriglycerides}}">
      <view class="list-label"> - 甘油三酯：</view>
      <view class="list-content {{screen.highTriglycerides >= 1.7 ? 'warn-text' : ''}}">{{screen.highTriglycerides}}
        mmol/L</view>
    </view>
    <view class="list-row" wx:if="{{screen.lowhdl}}">
      <view class="list-label"> - 高密度脂蛋白：</view>
      <view class="list-content {{screen.lowhdl < 1.04 ? 'warn-text' : ''}}">{{screen.lowhdl}} mmol/L</view>
    </view>

    <!-- 其他风险评分 -->
    <view class="list-row" wx:if="{{screen.findriscScore != null}}">
      <view class="list-label">糖尿病风险(FINDRISC)：</view>
      <view class="list-content {{screenDisplay.findriscLevel == '高风险' ? 'warn-text' : ''}}">
        {{screenDisplay.findriscLevel}} ({{screen.findriscScore}}分)</view>
    </view>
    <view class="list-row" wx:if="{{screen.nfsScore != null}}">
      <view class="list-label">肝纤维化风险(NFS)：</view>
      <view class="list-content {{screenDisplay.nfsLevel == '高风险' ? 'warn-text' : ''}}">{{screenDisplay.nfsLevel}}
        ({{screen.nfsScore}})</view>
    </view>
    <view class="list-row" wx:if="{{screen.egfr != null}}">
      <view class="list-label">肾功能(eGFR)：</view>
      <view class="list-content {{screen.egfr < 60 ? 'warn-text' : ''}}">{{screenDisplay.egfrLevel}} ({{screen.egfr}})
      </view>
    </view>
    <view class="list-row" wx:if="{{screen.phq9Score != null}}">
      <view class="list-label">抑郁风险(PHQ-9)：</view>
      <view class="list-content {{screen.phq9Score >= 10 ? 'warn-text' : ''}}">{{screenDisplay.phq9Level}}
        ({{screen.phq9Score}}分)</view>
    </view>
    <view class="list-row" wx:if="{{screen.gad7Score != null}}">
      <view class="list-label">焦虑风险(GAD-7)：</view>
      <view class="list-content {{screen.gad7Score >= 10 ? 'warn-text' : ''}}">{{screenDisplay.gad7Level}}
        ({{screen.gad7Score}}分)</view>
    </view>

    <!-- 新增图片对应指标 -->
    <view class="list-row" wx:if="{{screen.cvdRisk != null}}">
      <view class="list-label">心血管病风险(10年)：</view>
      <view class="list-content {{screen.cvdRisk >= 10 ? 'warn-text' : ''}}">{{screenDisplay.cvdLevel}}
        ({{screen.cvdRisk}}%)</view>
    </view>
    <view class="list-row" wx:if="{{screen.sdsIndex != null}}">
      <view class="list-label">抑郁自评(SDS)：</view>
      <view class="list-content {{screen.sdsIndex >= 0.5 ? 'warn-text' : ''}}">{{screenDisplay.sdsLevel}}
        (指数:{{screen.sdsIndex}})</view>
    </view>

  </view>

  <!-- 健康史信息 -->
  <view class="data-section" wx:if="{{diagnose}}">
    <view class="section-title">健康档案</view>
    <view class="list-row">
      <view class="list-label">过敏史：</view>
      <view class="list-content">{{diagnose.allergyHistory || '无'}}</view>
    </view>
    <view class="list-row">
      <view class="list-label">手术史：</view>
      <view class="list-content">{{diagnose.surgeryHistory || '无'}}</view>
    </view>
    <view class="list-row">
      <view class="list-label">吸烟史：</view>
      <view class="list-content">{{diagnose.smokingHistory == '1' ? '有' : '无'}}</view>
    </view>
    <view class="list-row">
      <view class="list-label">饮酒史：</view>
      <view class="list-content">{{diagnose.drinkingHistory || '无'}}</view>
    </view>
    <view class="list-row">
      <view class="list-label">最近诊断：</view>
      <view class="list-content">{{diagnose.diagnosisDate || '--'}}</view>
    </view>
  </view>

  <!-- 四诊信息 -->
  <view class="data-section" wx:if="{{fourDisplay}}">
    <view class="section-title">四诊信息详情</view>

    <view class="list-row" wx:if="{{fourDisplay.life}}">
      <view class="list-label">生命精神：</view>
      <view class="list-content">{{fourDisplay.life}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.coldHot}}">
      <view class="list-label">寒热：</view>
      <view class="list-content">{{fourDisplay.coldHot}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.sweat}}">
      <view class="list-label">汗出：</view>
      <view class="list-content">{{fourDisplay.sweat}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.pain}}">
      <view class="list-label">疼痛：</view>
      <view class="list-content">{{fourDisplay.pain}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.headBody}}">
      <view class="list-label">头身：</view>
      <view class="list-content">{{fourDisplay.headBody}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.sleep}}">
      <view class="list-label">睡眠：</view>
      <view class="list-content">{{fourDisplay.sleep}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.breath}}">
      <view class="list-label">咳痰喘：</view>
      <view class="list-content">{{fourDisplay.breath}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.food}}">
      <view class="list-label">饮食：</view>
      <view class="list-content">{{fourDisplay.food}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.stool}}">
      <view class="list-label">大便：</view>
      <view class="list-content">{{fourDisplay.stool}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.urine}}">
      <view class="list-label">小便：</view>
      <view class="list-content">{{fourDisplay.urine}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.female}}">
      <view class="list-label">月经/精液：</view>
      <view class="list-content">{{fourDisplay.female}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.bleeding}}">
      <view class="list-label">出血：</view>
      <view class="list-content">{{fourDisplay.bleeding}}</view>
    </view>
    <view class="list-row" wx:if="{{fourDisplay.voice}}">
      <view class="list-label">声音：</view>
      <view class="list-content">{{fourDisplay.voice}}</view>
    </view>
  </view>

  <!-- 操作区域 -->
  <view class="action-area">
    <button class="btn" bindtap="callPatient">拨打电话</button>
  </view>

</view>