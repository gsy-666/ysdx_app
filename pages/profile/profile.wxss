/* pages/profile/profile.wxss */
page {
  background-color: #f5f7fa;
  box-sizing: border-box;
}

.container {
  padding-bottom: 40rpx;
}

/* Header */
.header-bg {
  background: linear-gradient(135deg, #a8e6cf 0%, #1f8b73 100%);
  padding: 40rpx 40rpx 100rpx 40rpx;
  /* Extra padding for overlap */
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 30rpx;
  background: #fff;
}

.name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.uid {
  font-size: 24rpx;
  opacity: 0.9;
}

/* Card Common */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #1f8b73;
  padding-left: 20rpx;
}

/* Stats Strip (Overlaps Header) */
.stats-strip {
  display: flex;
  justify-content: space-around;
  margin-top: -60rpx;
  /* Pull up */
  padding: 40rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f8b73;
  margin-bottom: 8rpx;
}

.stat-item .label {
  font-size: 24rpx;
  color: #666;
}

/* Grid Box */
.grid-box {
  display: flex;
  justify-content: space-between;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.grid-icon {
  width: 60rpx;
  /* FIXED SIZE */
  height: 60rpx;
  margin-bottom: 16rpx;
}

.grid-item text {
  font-size: 26rpx;
  color: #333;
}

/* Menu List */
.menu-card {
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  /* FIXED SIZE */
  height: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #ccc;
  font-size: 28rpx;
}

.logout-btn {
  width: 90%;
  margin: 40rpx auto;
  background: #ffecf0;
  color: #f56c6c;
  border: none;
  font-size: 30rpx;
}