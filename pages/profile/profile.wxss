/* pages/profile/profile.wxss */
/* 引入全局古风书法字体 */
@font-face {
  font-family: "GufengShufa";
  src: url('/static/fonts/HanyiShangweiGufeng.ttf') format('truetype');
  font-display: swap;
}

page {
  background-color: #f9f5f0;
  /* 宣纸浅米黄底，替代原浅灰 */
  box-sizing: border-box;
  font-family: "GufengShufa", "Kaiti SC", "STKaiti", "KaiTi", "SimSun", serif;
}

.container {
  padding-bottom: 40rpx;
}

/* Header - 古风渐变替换 */
.header-bg {
  background: linear-gradient(135deg, #a0522d 0%, #8b4513 100%);
  /* 浅棕红→棕红渐变，替代原青绿渐变 */
  padding: 40rpx 40rpx 100rpx 40rpx;
  color: #fff;
}

.user-info {
  display: flex;
  align-items: center;
}

/* Fix for avatar inside button */
.avatar-btn .avatar {
  margin-right: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* 头像样式 - 古风适配 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 30rpx;
  background: #f5e8d5;
  /* 浅米底色，替代原纯白 */
}

.name {
  font-size: 36rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  margin-bottom: 10rpx;
  letter-spacing: 3rpx;
}

.uid {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

/* Card Common - 古风改造 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  /* 棕色调阴影，替代原黑色 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
}

/* 卡片标题 - 古风配色替换 */
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  margin-bottom: 30rpx;
  border-left: 8rpx solid #8b4513;
  /* 棕红左侧边，替代原青绿 */
  padding-left: 20rpx;
  letter-spacing: 3rpx;
}

/* Stats Strip (Overlaps Header) */
.stats-strip {
  display: flex;
  justify-content: space-around;
  margin-top: -60rpx;
  padding: 40rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .num {
  font-size: 36rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  color: #8b4513;
  /* 棕红主色，替代原青绿 */
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.stat-item .label {
  font-size: 24rpx;
  color: #a0522d;
  /* 浅棕红，替代原深灰 */
  letter-spacing: 2rpx;
}

/* Grid Box - 古风改造 */
.grid-box {
  display: flex;
  justify-content: space-between;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}

.grid-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  /* 新增圆角 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
  background-color: #f5e8d5;
  /* 浅米底色，强化古风 */
  padding: 8rpx;
  box-sizing: border-box;
}

.grid-item text {
  font-size: 26rpx;
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  letter-spacing: 2rpx;
}

/* Menu List - 古风改造 */
.menu-card {
  padding: 0 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  border: 1rpx solid #d2b48c;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5e8d5;
  /* 浅米分隔线，替代原浅灰 */
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 24rpx;
  border-radius: 6rpx;
  /* 新增圆角 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
  background-color: #f5e8d5;
  /* 浅米底色 */
  padding: 4rpx;
  box-sizing: border-box;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  letter-spacing: 2rpx;
}

.arrow {
  color: #d2b48c;
  /* 棕木色，替代原浅灰 */
  font-size: 28rpx;
}

/* 退出按钮 - 古风配色替换 */
.logout-btn {
  width: 90%;
  margin: 40rpx auto;
  background: #f5e8d5;
  /* 浅米底色，替代原浅红 */
  color: #8b4513;
  /* 棕红主色，替代原红色 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
  font-size: 30rpx;
  border-radius: 8rpx;
  letter-spacing: 4rpx;
}

/* 角色标签 - 古风适配 */
.role-tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}