/* pages/profile/profile.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding-bottom: 40rpx;
}

/* Header - 科技深蓝 */
.header-bg {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.95), rgba(11, 17, 32, 0.95));
  padding: 40rpx 40rpx 100rpx 40rpx;
  color: var(--text-main);
  border-bottom: 1px solid var(--border-color);
}

.user-info {
  display: flex;
  align-items: center;
}

/* Fix for avatar inside button */
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  border-radius: 50%;
  margin-right: 30rpx;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

/* 头像样式 - 科技光圈 */
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-color);
  background: rgba(0, 0, 0, 0.3);
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.4);
}

.text-info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  letter-spacing: 3rpx;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.role-tag {
  font-size: 22rpx;
  background: rgba(76, 201, 240, 0.2);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  border: 1rpx solid var(--primary-color);
}

.uid {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
  color: var(--text-sub);
}

/* Card Common - 玻璃拟态 */
.card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid var(--border-color);
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 30rpx;
  border-left: 8rpx solid var(--primary-color);
  padding-left: 20rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 3rpx var(--primary-color);
}

/* Stats Strip (Overlaps Header) */
.stats-strip {
  display: flex;
  justify-content: space-around;
  margin-top: -60rpx;
  padding: 30rpx 0;
  position: relative;
  z-index: 10;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item .num {
    color: var(--primary-color);
    font-size: 36rpx;
    font-weight: bold;
    text-shadow: 0 0 5rpx var(--primary-color);
    margin-bottom: 8rpx;
}

.stat-item .label {
    color: var(--text-sub);
    font-size: 24rpx;
}

/* Grid Box (My Services) */
.grid-box {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.grid-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  background: rgba(76, 201, 240, 0.1);
  border-radius: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.1);
}

.grid-item text {
  font-size: 24rpx;
  color: var(--text-main);
}

/* Menu List */
.menu-card {
  padding: 0 30rpx;
}

.menu-item {
    padding: 30rpx 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
}

.menu-item:last-child {
    border-bottom: none;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  opacity: 0.8;
}

.menu-text {
    flex: 1;
    font-size: 28rpx;
    color: var(--text-main);
}

.arrow {
    color: var(--border-color);
    font-size: 30rpx;
}

/* Logout Button */
.footer {
  margin: 60rpx 30rpx;
}

.logout-btn {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 40rpx;
  font-size: 30rpx;
  box-shadow: 0 0 10rpx rgba(255, 77, 79, 0.2);
}

.logout-btn:active {
  background: rgba(255, 77, 79, 0.2);
}
