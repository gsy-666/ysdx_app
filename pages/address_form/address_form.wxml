<view class="container">
  <view class="form-group">
    <view class="form-item">
      <text class="label">联系人</text>
      <input class="input" placeholder="名字" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="11位手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="label">地区</text>
      <picker mode="region" bindchange="onRegionChange" value="{{region}}">
        <view class="picker {{region.length === 0 ? 'placeholder' : ''}}">
          {{region.length > 0 ? region[0] + ' ' + region[1] + ' ' + region[2] : '选择省/市/区'}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">详细地址</text>
      <textarea class="textarea" placeholder="街道门牌、楼层房间号等信息" value="{{detail}}" bindinput="onDetailInput"></textarea>
    </view>
  </view>

  <view class="btn-group">
    <button class="save-btn" bindtap="saveAddress">保存地址</button>
  </view>
</view>