/* pages/article/article.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.article-item {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 16rpx;
  display: block;
  text-shadow: 0 0 2rpx rgba(76, 201, 240, 0.5);
  letter-spacing: 2rpx;
}

.desc {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  display: block;
  line-height: 1.5;
  opacity: 0.8;
}