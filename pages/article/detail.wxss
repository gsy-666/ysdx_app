/* pages/article/detail.wxss */
page {
  background-color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  padding: 30rpx 32rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.article-wrap {
  width: 100%;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.4;
  color: #333333;
  margin-bottom: 24rpx;
  text-shadow: none;
  text-align: justify;
}

.meta {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.author {
  color: #576b95;
  margin-right: 24rpx;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  margin-right: 30rpx;
}

.content {
  font-size: 34rpx;
  line-height: 1.75;
  color: #222222;
  word-wrap: break-word;
  text-align: justify;
}
