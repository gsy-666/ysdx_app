/* pages/article/detail.wxss */
page {
  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: inherit;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
  text-align: center;
  line-height: 1.4;
}

.article-content {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text-main);
  opacity: 0.9;
  letter-spacing: 1rpx;
}
