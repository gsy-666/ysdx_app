/* pages/connect/chat/chat.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  background-color: var(--bg-color);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.msg-self {
  justify-content: flex-end;
}

.msg-other {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 28rpx;
  color: var(--text-main);
  border: 1rpx solid var(--border-color);
}

.bubble {
  padding: 24rpx;
  border-radius: 12rpx;
  max-width: 70%;
  margin: 0 20rpx;
  font-size: 30rpx;
  position: relative;
  line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* User Bubble (Green/Cyan) */
.msg-self .bubble {
  background: rgba(76, 201, 240, 0.2);
  border: 1rpx solid var(--primary-color);
  color: #fff;
  border-top-right-radius: 2rpx;
}

/* Other Bubble (Dark Glass) */
.msg-other .bubble {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: var(--text-main);
  border-top-left-radius: 2rpx;
}

/* Input Area */
.input-area {
  background: rgba(11, 17, 32, 0.95);
  backdrop-filter: blur(10px);
  padding: 20rpx;
  border-top: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
}

.msg-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  color: var(--text-main);
  margin-right: 20rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 70rpx;
  line-height: 70rpx;
  background: linear-gradient(90deg, #16213e, #4cc9f0);
  color: white;
  font-size: 26rpx;
  border-radius: 8rpx;
  padding: 0;
  border: none;
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.3);
}
