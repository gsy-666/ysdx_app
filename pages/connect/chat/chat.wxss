page {
  background-color: #F4F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1A1A1A;
}

.container {
  background-color: #F4F7F9;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 30rpx 30rpx 0rpx 30rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}

.msg-self {
  justify-content: flex-end;
}

.msg-other {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.ai-avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-other {
  background: #FFFFFF;
  color: #3B99FC;
}

.avatar-self {
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
}

.bubble {
  padding: 24rpx 32rpx;
  max-width: 65%;
  font-size: 30rpx;
  position: relative;
  line-height: 1.5;
  word-break: break-all;
}

/* User Bubble (Blue) */
.msg-self .bubble {
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
  border-radius: 30rpx 8rpx 30rpx 30rpx;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(59, 153, 252, 0.2);
}

/* Other Bubble (White) */
.msg-other .bubble {
  background: #FFFFFF;
  color: #1A2233;
  border-radius: 8rpx 30rpx 30rpx 30rpx;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);
}

/* Input Area */
.input-bar {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(13, 26, 43, 0.04);
}

.input {
  flex: 1;
  background: #F4F7F9;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 80rpx;
  color: #1A2233;
  margin-right: 24rpx;
  font-size: 30rpx;
}

.send-btn {
  margin: 0;
  width: 140rpx !important;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(59, 153, 252, 0.3);
  transition: all 0.2s ease;
}

.send-btn::after {
  display: none;
}

.send-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}