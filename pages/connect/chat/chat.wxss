/* pages/connect/chat/chat.wxss */
.container {
  background-color: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.msg-self {
  justify-content: flex-end;
}

.msg-other {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  background: #ddd;
  border-radius: 4rpx;
  text-align: center;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #666;
}

.bubble {
  background: #fff;
  padding: 20rpx;
  border-radius: 4rpx;
  max-width: 60%;
  margin: 0 20rpx;
  font-size: 30rpx;
  position: relative;
}

.msg-self .bubble {
  background: #95ec69;
}

.input-bar {
  background: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
}

.input {
  flex: 1;
  background: #f5f5f5;
  height: 70rpx;
  border-radius: 4rpx;
  padding: 0 20rpx;
  margin-right: 20rpx;
}

.send-btn {
  width: 150rpx;
  height: 70rpx;
  font-size: 28rpx;
  line-height: 70rpx;
  background: #409EFF;
  color: #fff;
  padding: 0;
  border-radius: 4rpx;
}