/* pages/connect/chat/chat.wxss */
page {
  background-color: #F4F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1A1A1A;
}

.container {
  background-color: #F4F7F9;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 30rpx 24rpx 0 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.msg-self {
  justify-content: flex-end;
}

.msg-other {
  justify-content: flex-start;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  text-align: center;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.ai-avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-other {
  background: #FFFFFF;
  color: #3B99FC;
}

.avatar-self {
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
}

.bubble {
  padding: 22rpx 28rpx;
  max-width: 72%;
  font-size: 30rpx;
  position: relative;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-self .bubble {
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
  border-radius: 28rpx 10rpx 28rpx 28rpx;
  margin-right: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(59, 153, 252, 0.2);
}

.msg-other .bubble {
  background: #FFFFFF;
  color: #1A2233;
  border-radius: 10rpx 28rpx 28rpx 28rpx;
  margin-left: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);
}

.bubble-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.bubble-section {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin: 8rpx 0 10rpx;
}

.bubble-list {
  display: block;
  padding-left: 24rpx;
  text-indent: -18rpx;
  margin: 6rpx 0;
}

.bubble-text {
  display: block;
  margin: 4rpx 0;
}

.input-bar {
  background: #FFFFFF;
  padding: 22rpx 24rpx;
  padding-bottom: calc(22rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(22rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(13, 26, 43, 0.04);
}

.input {
  flex: 1;
  background: #F4F7F9;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 80rpx;
  color: #1A2233;
  margin-right: 20rpx;
  font-size: 30rpx;
}

.send-btn {
  margin: 0;
  width: 140rpx !important;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0;
  border: none;
  box-shadow: 0 6rpx 16rpx rgba(59, 153, 252, 0.3);
}

.send-btn::after {
  display: none;
}
