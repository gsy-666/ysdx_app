page {
  background-color: #F4F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #1A1A1A;
}

.container {
  padding: 30rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* AI Entrance Styles */
.ai-box {
  background: linear-gradient(135deg, #3B99FC 0%, #1A7DF9 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 28rpx rgba(59, 153, 252, 0.25);
  transition: transform 0.2s ease;
}

.ai-box:active {
  transform: scale(0.98);
}

.ai-info {
  flex: 1;
  padding-right: 20rpx;
}

.ai-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.ai-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
}

.ai-btn {
  margin: 0;
  background: #FFFFFF;
  color: #1A7DF9;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.ai-btn::after {
  display: none;
}

/* Doctor Team Section */
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A2233;
  margin-bottom: 30rpx;
  padding-left: 4rpx;
}

.doc-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);
}

.doc-info {
  flex: 1;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A2233;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.title {
  font-size: 22rpx;
  color: #3B99FC;
  background: #F0F6FF;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.dept {
  font-size: 28rpx;
  color: #728299;
}

.contact-btn {
  margin: 0;
  background: #F0F6FF;
  color: #3B99FC;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  flex-shrink: 0;
  border: none;
  transition: all 0.2s ease;
}

.contact-btn::after {
  display: none;
}

.contact-btn:active {
  transform: scale(0.95);
  background: #E1EFFF;
}