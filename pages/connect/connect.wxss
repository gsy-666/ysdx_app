/* pages/connect/connect.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.doc-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.title {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
  font-weight: normal;
}

.dept {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.contact-btn {
  margin: 0;
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background-color: #409EFF;
  color: white;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* AI Entrance Styles */
.ai-box {
  background: linear-gradient(135deg, #409EFF 0%, #007aff 100%);
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3);
}

.ai-info {
  flex: 1;
}

.ai-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.ai-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.ai-btn {
  font-size: 24rpx;
  background: #fff;
  color: #409EFF;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  margin-left: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0;
  padding-left: 10rpx;
  border-left: 8rpx solid #409EFF;
}