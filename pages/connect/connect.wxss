/* pages/connect/connect.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.doc-card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
}

.name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.title {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-left: 10rpx;
  font-weight: normal;
  border: 1rpx solid var(--border-color);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.dept {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  opacity: 0.8;
}

.contact-btn {
  margin: 0;
  width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: rgba(76, 201, 240, 0.15);
  color: var(--primary-color);
  font-size: 26rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--primary-color);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.2);
}

.contact-btn:active {
  background: rgba(76, 201, 240, 0.3);
}

/* AI Entrance Styles */
.ai-box {
  background: linear-gradient(135deg, rgba(76, 201, 240, 0.2) 0%, rgba(22, 33, 62, 0.8) 100%);
  border: 1rpx solid var(--primary-color);
  box-shadow: 0 0 20rpx rgba(76, 201, 240, 0.3);
  padding: 30rpx;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
}

.ai-icon-img {
  width: 100rpx;
  height: 100rpx;
  filter: drop-shadow(0 0 10rpx var(--primary-color));
}

.ai-text h3 {
  color: var(--primary-color);
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 0 8rpx var(--primary-color);
}

.ai-text p {
  color: var(--text-sub);
  font-size: 24rpx;
}
