/* pages/community/community.wxss */
/* Font file missing, removing @font-face to prevent errors */

page {
  background-color: #f9f5f0;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "SimSun", serif;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 筛选栏 - 文字居中 */
.filter-bar {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d2b48c;
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
}

.filter-item {
  font-size: 26rpx;
  color: #a0522d;
  letter-spacing: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  text-align: center;
  /* 文字居中 */
  width: 20%;
  /* 固定宽度，确保居中效果 */
}

.filter-item.active {
  background-color: #8b4513;
  color: #fff;
}

/* 排序+搜索栏 - 排序按钮文字居中 */
.search-sort-box {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 内部元素水平居中 */
  background-color: #fff;
  border: 1rpx solid #d2b48c;
  border-radius: 8rpx 0 0 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #8b4513;
  text-align: center;
  /* 文字居中 */
  min-width: 120rpx;
  /* 固定宽度，避免文字挤压 */
}

.sort-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #fff;
  border: 1rpx solid #d2b48c;
  border-left: none;
  border-radius: 0 30rpx 30rpx 0;
  padding: 12rpx 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #8b4513;
  letter-spacing: 2rpx;
  text-align: left;
  /* 搜索输入框文字左对齐（符合习惯） */
}

.search-input::placeholder {
  color: #d2b48c;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 10rpx;
}

/* 悬浮发布按钮 - 文字居中 */
.publish-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #8b4513;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 69, 19, 0.4);
  z-index: 99;
  text-align: center;
  /* 文字居中 */
}

.publish-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.publish-btn text {
  font-size: 20rpx;
  color: #fff;
  text-align: center;
  /* 文字居中 */
}

/* 帖子列表 */
.article-list {
  height: calc(100vh - 200rpx);
}

.article-item {
  background-color: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #d2b48c;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
}

.article-item-hover {
  background-color: #f5e8d5;
}

/* 作者信息 - 名称居中（可选，若需要） */
.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 1rpx solid #d2b48c;
  margin-right: 16rpx;
}

.author-name {
  font-size: 28rpx;
  color: #8b4513;
  flex: 1;
  text-align: left;
  /* 作者名左对齐（符合阅读习惯） */
}

.follow-btn {
  font-size: 22rpx;
  color: #8b4513;
  border: 1rpx solid #8b4513;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
  text-align: center;
  /* 按钮文字居中 */
}

.follow-btn.followed {
  background-color: #8b4513;
  color: #fff;
}

/* 帖子内容 - 标题/描述左对齐（阅读习惯），元信息/互动栏居中 */
.article-title {
  font-size: 32rpx;
  color: #8b4513;
  letter-spacing: 3rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.5;
  text-align: left;
}

.article-desc {
  font-size: 24rpx;
  color: #a0522d;
  letter-spacing: 1rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-align: left;
}

/* 图片组 */
.article-img-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  position: relative;
  /* 兼容图片数量提示 */
}

.article-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d2b48c;
}

.img-more {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  text-align: center;
  /* 数字提示居中 */
}

/* 帖子元信息 - 文字居中 */
.article-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #d2b48c;
  text-align: center;
  /* 文字居中 */
}

.article-time,
.article-category {
  text-align: center;
  /* 单独指定，确保居中 */
}

/* 互动栏 - 文字居中 */
.article-interact {
  display: flex;
  justify-content: space-around;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5e8d5;
  text-align: center;
  /* 整体文字居中 */
}

.interact-item {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 内部元素居中 */
  font-size: 24rpx;
  color: #a0522d;
  text-align: center;
  /* 文字居中 */
  width: 20%;
  /* 固定宽度，确保均匀分布+居中 */
}

.interact-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 加载/空数据/无更多 - 文字居中（核心调整） */
.loading,
.no-more,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  /* 文字居中 */
  padding: 40rpx 0;
  color: #a0522d;
  font-size: 28rpx;
  letter-spacing: 3rpx;
}

.empty image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-publish-btn {
  background-color: #8b4513;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  text-align: center;
  /* 按钮文字居中 */
}