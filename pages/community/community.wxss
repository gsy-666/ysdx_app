/* pages/community/community.wxss */
page { 
  background-color: var(--bg-color, #F5F7FA); 
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  background: var(--card-bg, #FFFFFF);
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  justify-content: flex-start;
  gap: 20rpx;
  overflow-x: auto;
}
.filter-item {
  font-size: 28rpx;
  color: var(--text-sub, #64748B);
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  background: #F0F4F7;
  white-space: nowrap;
  transition: all 0.3s ease;
}
.filter-item.active {
  background: var(--primary-color, #3B99FC);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(59, 153, 252, 0.3);
}

/* Search + Sort */
.search-sort-box {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--bg-color, #F5F7FA);
}
.sort-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-main, #333);
  margin-right: 24rpx;
  font-weight: 500;
}
.sort-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  color: #999;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--card-bg, #FFFFFF);
  border-radius: 40rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main, #333);
}

/* Publish Button */
.publish-btn {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  background: var(--primary-gradient, linear-gradient(135deg, #56CCF2 0%, #2F80ED 100%));
  color: #FFFFFF;
  padding: 24rpx 48rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 10rpx 30rpx rgba(47, 128, 237, 0.4);
  z-index: 50;
  transition: transform 0.2s;
}
.publish-btn:active {
  transform: scale(0.95);
}
.publish-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

/* Article List */
.article-list {
  padding: 10rpx 20rpx 40rpx 20rpx;
  height: calc(100vh - 180rpx);
  box-sizing: border-box;
}
.article-item {
  background: var(--card-bg, #FFFFFF);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.article-item-hover { 
  opacity: 0.95; 
  background-color: #FAFAFA;
}

/* Author */
.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.author-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F0F4F7;
  border: 1rpx solid #E6EEF5;
}
.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main, #1F3A56);
  flex: 1;
}
.follow-btn {
  font-size: 24rpx;
  border: 2rpx solid var(--primary-color, #3B99FC);
  color: var(--primary-color, #3B99FC);
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  font-weight: 500;
  background: rgba(59, 153, 252, 0.05);
}
.follow-btn.followed {
  border: 2rpx solid #E2E8F0;
  color: #94A3B8;
  background: #F8FAFC;
}

/* Content */
.article-content { 
  margin-bottom: 20rpx; 
}
.article-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main, #1F3A56);
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.article-desc {
  font-size: 28rpx;
  color: var(--text-sub, #475569);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* Images */
.article-img-group {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  gap: 12rpx;
}
.article-img {
  width: calc((100% - 24rpx) / 3);
  height: 210rpx;
  border-radius: 16rpx;
  background: #F0F4F7;
  object-fit: cover;
}
.img-more {
  width: calc((100% - 24rpx) / 3);
  height: 210rpx;
  background: rgba(0, 0, 0, 0.03);
  color: var(--text-sub, #64748B);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 500;
}

/* Meta */
.article-meta {
  font-size: 24rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.article-category {
  background: rgba(59, 153, 252, 0.1);
  color: var(--primary-color, #3B99FC);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* Interaction */
.article-interact {
  display: flex;
  justify-content: space-between;
  border-top: 2rpx solid #F1F5F9;
  padding-top: 24rpx;
}
.interact-item {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: center;
}
.interact-icon {
  font-size: 36rpx;
  line-height: 36rpx;
  margin-right: 12rpx;
}
.interact-item text:last-child {
  font-size: 26rpx;
  color: var(--text-sub, #64748B);
  font-weight: 500;
}
.share-btn-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}
.share-btn-wrap::after {
  border: none;
}

/* Empty / Loading states */
.loading, .no-more {
  text-align: center;
  padding: 30rpx 0;
  color: #94A3B8;
  font-size: 26rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.empty image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}
.empty text {
  color: #94A3B8;
  font-size: 30rpx;
  margin-bottom: 40rpx;
}
.empty-publish-btn {
  background: var(--primary-color, #3B99FC);
  color: #FFF;
  border-radius: 40rpx;
  padding: 0 60rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  height: 80rpx;
}
