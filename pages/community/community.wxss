/* pages/community/community.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 筛选栏 - 文字居中 */
.filter-bar {
  display: flex;
  justify-content: space-around;
  background-color: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.filter-item {
  font-size: 26rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  text-align: center;
  width: 20%;
}

.filter-item.active {
  background-color: var(--primary-color);
  color: #0b1120;
  font-weight: bold;
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.4);
}

/* 排序+搜索栏 */
.search-sort-box {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(22, 33, 62, 0.6);
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx 0 0 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  text-align: center;
  min-width: 120rpx;
}

.sort-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  filter: drop-shadow(0 0 5rpx var(--primary-color));
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: rgba(22, 33, 62, 0.6);
  border: 1rpx solid var(--border-color);
  border-left: none;
  border-radius: 0 30rpx 30rpx 0;
  padding: 12rpx 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  letter-spacing: 2rpx;
  text-align: left;
}

.search-input::placeholder {
  color: var(--text-sub);
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 10rpx;
  /* filter: invert(1); Optional based on icon color */
}

/* 话题卡片 */
.post-card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--border-color);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 35rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--primary-color);
}

.info-text {
  flex: 1;
}

.nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 2rpx;
}

.time {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.post-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 2rpx var(--primary-color);
}

.post-content {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.tag-list {
  display: flex;
}

.tag {
  font-size: 22rpx;
  background-color: rgba(76, 201, 240, 0.1);
  color: var(--primary-color);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  border: 1px solid var(--border-color);
}

.interact-box {
  display: flex;
  gap: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-sub);
}

.icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
  /* filter: invert(1); */
}

/* 悬浮发布按钮 */
.publish-btn {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--primary-color);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(76, 201, 240, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border: 2rpx solid #fff;
}

.pub-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
  /* filter: invert(1); */
}

.pub-text {
  font-size: 20rpx;
  color: #0b1120;
  font-weight: bold;
}
