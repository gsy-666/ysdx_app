<view class="container">
  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{activeType === 'all' ? 'active' : ''}}" bindtap="changeType" data-type="all">全部</view>
    <view class="filter-item {{activeType === 'health' ? 'active' : ''}}" bindtap="changeType" data-type="health">健康科普
    </view>
    <view class="filter-item {{activeType === 'experience' ? 'active' : ''}}" bindtap="changeType"
      data-type="experience">经验分享</view>
    <view class="filter-item {{activeType === 'question' ? 'active' : ''}}" bindtap="changeType" data-type="question">
      提问求助</view>
  </view>

  <!-- 排序+搜索栏 -->
  <view class="search-sort-box">
    <view class="sort-btn" bindtap="changeSort">
      <text>{{activeSort === 'hot' ? '热度' : '时间'}}</text>
      <image src="/static/arrow_down.png" class="sort-icon"></image>
    </view>
    <view class="search-box">
      <input class="search-input" placeholder="搜索健康资讯..." bindinput="bindSearchInput" confirm-type="search"
        bindconfirm="onSearch" />
      <image class="search-icon" src="/static/search.png" bindtap="onSearch"></image>
    </view>
  </view>

  <!-- 发布按钮（悬浮） -->
  <view class="publish-btn" bindtap="goToPublish">
    <image src="/static/add.png" class="publish-icon"></image>
    <text>发布</text>
  </view>

  <!-- 文章列表 -->
  <scroll-view scroll-y="true" class="article-list" bindscrolltolower="onReachBottom" refresher-enabled="{{true}}"
    refresher-triggered="{{triggered}}" bindrefresherrefresh="onPullDownRefresh">
    <block wx:for="{{articleList}}" wx:key="id" wx:for-index="pIndex">
      <view class="article-item" bindtap="goToDetail" data-id="{{item.id}}" hover-class="article-item-hover">
        <!-- 作者信息 -->
        <view class="author-info">
          <image class="author-avatar" src="{{item.authorAvatar || '/static/default_avatar.png'}}" mode="aspectFill">
          </image>
          <view class="author-name">{{item.authorName || '匿名用户'}}</view>
          <view class="follow-btn {{item.isFollowed ? 'followed' : ''}}" bindtap="toggleFollow"
            data-author-id="{{item.authorId}}" catchtap="true">
            {{item.isFollowed ? '已关注' : '+关注'}}
          </view>
        </view>
        <!-- 帖子内容 -->
        <view class="article-content">
          <view class="article-title">{{item.title}}</view>
          <view class="article-desc">{{item.content}}</view>
          <!-- 图片组 -->
          <view class="article-img-group" wx:if="{{item.images && item.images.length > 0}}">
            <block wx:for="{{item.images}}" wx:key="index" wx:for-index="imgIndex" wx:if="{{imgIndex < 3}}">
              <image class="article-img" src="{{item}}" mode="aspectFill" binderror="onImageError"
                data-pindex="{{pIndex}}" data-imgindex="{{imgIndex}}"></image>
            </block>
            <view class="img-more" wx:if="{{item.images.length > 3}}">+{{item.images.length - 3}}</view>
          </view>
          <!-- 帖子元信息 -->
          <view class="article-meta">
            <text class="article-time">{{item.createTime}}</text>
            <text class="article-category">{{item.categoryName}}</text>
          </view>
          <!-- 互动栏 -->
          <view class="article-interact">
            <view class="interact-item" bindtap="toggleLike" data-id="{{item.id}}" catchtap="true">
              <image src="{{item.isLiked ? '/static/like_active.png' : '/static/like.png'}}" class="interact-icon">
              </image>
              <text>{{item.likeCount || 0}}</text>
            </view>
            <view class="interact-item" bindtap="toggleCollect" data-id="{{item.id}}" catchtap="true">
              <image src="{{item.isCollected ? '/static/collect_active.png' : '/static/collect.png'}}"
                class="interact-icon"></image>
              <text>{{item.collectCount || 0}}</text>
            </view>
            <view class="interact-item" bindtap="goToDetail" data-id="{{item.id}}">
              <image src="/static/comment.png" class="interact-icon"></image>
              <text>{{item.commentCount || 0}}</text>
            </view>
            <view class="interact-item" bindtap="sharePost" data-id="{{item.id}}" catchtap="true">
              <image src="/static/share.png" class="interact-icon"></image>
              <text>分享</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{!hasMore && articleList.length > 0}}">没有更多帖子了</view>
    <view class="empty" wx:if="{{articleList.length === 0 && !loading}}">
      <image src="/static/empty_community.png" mode="aspectFit"></image>
      <text>暂无相关帖子</text>
      <button class="empty-publish-btn" bindtap="goToPublish">发布第一条帖子</button>
    </view>
  </scroll-view>
</view>