/* pages/community/publish.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 输入项通用 */
.input-item,
.select-item,
.textarea-item,
.upload-item {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.input-label,
.select-label,
.textarea-label,
.upload-label {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
  display: block;
  letter-spacing: 1rpx;
}

/* 标题输入 */
.title-input {
  font-size: 30rpx;
  color: var(--text-main);
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  background: transparent;
}

.title-input::placeholder {
  color: var(--text-sub);
  opacity: 0.5;
}

/* 分类选择 */
.select-value {
  color: var(--primary-color);
}

/* 文本域 */
.content-input {
  width: 100%;
  color: var(--text-main);
  line-height: 1.6;
}

.content-input::placeholder {
  color: var(--text-sub);
  opacity: 0.5;
}

/* 图片上传格 */
.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  position: relative;
  border: 1rpx solid var(--border-color);
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: rgba(255, 77, 79, 0.8);
  color: white;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background: rgba(76, 201, 240, 0.05);
  border: 2rpx dashed var(--border-color);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
  color: var(--primary-color);
}

/* Bottom Bar */
.submit-btn {
  margin-top: 50rpx;
  background: linear-gradient(90deg, #16213e, #4cc9f0);
  color: #fff;
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.4);
  letter-spacing: 4rpx;
}
