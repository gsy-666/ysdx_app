/* pages/community/detail.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  min-height: 100vh;
}

.post-content {
  padding: 20rpx;
  /* Adjust if needed for fixed footer, usually has padding-bottom */
  padding-bottom: 120rpx;
}

/* 帖子头部 */
.post-header {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.author-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 1rpx solid var(--primary-color);
  margin-right: 20rpx;
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.3);
}

.author-detail {
  flex: 1;
}

.author-name {
  font-size: 32rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  font-weight: 500;
  text-shadow: 0 0 3rpx var(--primary-color);
}

.post-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.post-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.post-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.post-images {
  margin-top: 20rpx;
}

.post-img {
  width: 100%;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

/* Comments Section */
.comments-section {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  padding: 30rpx;
  border: 1rpx solid var(--border-color);
}

.section-title {
  font-size: 30rpx;
  color: var(--text-main);
  margin-bottom: 30rpx;
  border-left: 6rpx solid var(--primary-color);
  padding-left: 20rpx;
  letter-spacing: 2rpx;
}

.comment-item {
  display: flex;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding-bottom: 20rpx;
}

.c-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 1rpx solid var(--border-color);
}

.c-content {
  flex: 1;
}

.c-author {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.c-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
}

.c-time {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  opacity: 0.7;
}

/* Footer Action Bar */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(11, 17, 32, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--border-color);
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  z-index: 100;
}

.comment-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 30rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.action-icons {
  display: flex;
  gap: 30rpx;
}

.icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.icon-img {
  width: 44rpx;
  height: 44rpx;
  filter: drop-shadow(0 0 5rpx var(--primary-color));
}

.icon-num {
  font-size: 20rpx;
  color: var(--text-sub);
}
