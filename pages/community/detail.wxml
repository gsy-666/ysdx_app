<view class="container">
  <!-- 帖子内容 -->
  <scroll-view scroll-y="true" class="post-content" refresher-enabled="{{true}}" refresher-triggered="{{triggered}}"
    bindrefresherrefresh="onPullDownRefresh">
    <view class="post-header">
      <view class="author-info">
        <image class="author-avatar" src="{{postInfo.authorAvatar || '/static/default_avatar.png'}}" mode="aspectFill">
        </image>
        <view class="author-detail">
          <view class="author-name">{{postInfo.authorName || '匿名用户'}}</view>
          <view class="post-time">{{postInfo.createTime}}</view>
        </view>
        <view class="follow-btn {{postInfo.isFollowed ? 'followed' : ''}}" bindtap="toggleFollow" catchtap="true">
          {{postInfo.isFollowed ? '已关注' : '+关注'}}
        </view>
      </view>
      <view class="post-title">{{postInfo.title}}</view>
      <view class="post-desc">{{postInfo.content}}</view>
      <!-- 帖子图片 -->
      <view class="post-img-group" wx:if="{{postInfo.images && postInfo.images.length > 0}}">
        <block wx:for="{{postInfo.images}}" wx:key="index">
          <image class="post-img" src="{{item}}" mode="aspectFit" bindtap="previewImage" data-url="{{item}}"
            data-list="{{postInfo.images}}"></image>
        </block>
      </view>
      <!-- 互动栏 -->
      <view class="post-interact">
        <view class="interact-item" bindtap="toggleLike" catchtap="true">
          <!-- <image src="{{postInfo.isLiked ? '/static/like_active.png' : '/static/like.png'}}" class="interact-icon"></image> -->
          <text class="emoji-icon">{{postInfo.isLiked ? '❤️' : '🤍'}}</text>
          <text>{{postInfo.likeCount || 0}}</text>
        </view>
        <view class="interact-item" bindtap="toggleCollect" catchtap="true">
          <!-- <image src="{{postInfo.isCollected ? '/static/collect_active.png' : '/static/collect.png'}}" class="interact-icon"></image> -->
          <text class="emoji-icon">{{postInfo.isCollected ? '⭐' : '☆'}}</text>
          <text>{{postInfo.collectCount || 0}}</text>
        </view>
        <view class="interact-item" bindtap="sharePost" catchtap="true">
          <!-- <image src="/static/share.png" class="interact-icon"></image> -->
          <text class="emoji-icon">↗️</text>
          <text>分享</text>
        </view>
      </view>
    </view>

    <!-- 评论区 -->
    <view class="comment-section">
      <view class="comment-title">评论区 ({{postInfo.commentCount || 0}})</view>
      <!-- 发布评论 -->
      <view class="comment-input-box">
        <input class="comment-input" placeholder="说点什么..." bindinput="bindCommentInput" value="{{commentContent}}" />
        <button class="send-btn" bindtap="publishComment">发布</button>
      </view>
      <!-- 评论列表 -->
      <view class="comment-list">
        <block wx:for="{{commentList}}" wx:key="id">
          <view class="comment-item">
            <image class="comment-avatar" src="{{item.authorAvatar || '/static/default_avatar.png'}}" mode="aspectFill">
            </image>
            <view class="comment-content">
              <view class="comment-author">{{item.authorName}}</view>
              <view class="comment-text">{{item.content}}</view>
              <view class="comment-footer">
                <text class="comment-time">{{item.createTime}}</text>
                <view class="comment-interact">
                  <text class="comment-like" bindtap="likeComment" data-id="{{item.id}}" catchtap="true">
                    {{item.likeCount || 0}} 赞
                  </text>
                  <text class="comment-reply" bindtap="replyComment" data-id="{{item.id}}"
                    data-name="{{item.authorName}}" catchtap="true">
                    回复
                  </text>
                </view>
              </view>
              <!-- 回复列表 -->
              <view class="reply-list" wx:if="{{item.replies && item.replies.length > 0}}">
                <block wx:for="{{item.replies}}" wx:key="id">
                  <view class="reply-item">
                    <text class="reply-author">{{item.replyAuthorName}}</text>
                    <text class="reply-to" wx:if="{{item.replyToName}}"> 回复 {{item.replyToName}}：</text>
                    <text class="reply-text">{{item.content}}</text>
                  </view>
                </block>
              </view>
              <!-- 回复输入框 -->
              <view class="reply-input-box" wx:if="{{replyId === item.id}}">
                <input class="reply-input" placeholder="回复 {{item.authorName}}..." bindinput="bindReplyInput"
                  value="{{replyContent}}" />
                <button class="reply-send-btn" bindtap="publishReply" data-id="{{item.id}}" catchtap="true">发送</button>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="loading-comment" wx:if="{{loadingComment}}">加载评论中...</view>
      <view class="no-comment" wx:if="{{!loadingComment && commentList.length === 0}}">暂无评论，快来抢沙发～</view>
    </view>
  </scroll-view>
</view>