page {
  background: radial-gradient(circle at top, #1e293b, #0f172a 60%, #000000);
  min-height: 100vh;
  color: #fff;
  font-family: 'PingFang SC', sans-serif;
  overflow-x: hidden;
}

.container {
  padding: 0 30rpx 40rpx;
  display: flex;
  flex-direction: column;
}

/* === Top Section === */
.top-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: auto; /* 取消固定高度，适配环形 */
  padding-bottom: 20rpx;
  margin-bottom: -40rpx;
  width: 100%;
}

.nav-bar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  z-index: 10;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  text-shadow: 0 0 10rpx rgba(76, 201, 240, 0.5);
}

/* 核心修复：改用vw单位+强制1:1宽高比，适配所有屏幕 */
.avatar-ring-wrapper {
  position: relative;
  width: 80vw; /* 视口宽度的80%，替代固定rpx */
  max-width: 580rpx; /* 限制最大宽度，避免大屏变形 */
  aspect-ratio: 1/1; /* 强制宽高比1:1，永远正圆 */
  margin: 30rpx auto 0;
  transform-origin: center center;
}

.avatar-img {
  position: absolute;
  width: 70%; /* 相对父容器，而非固定rpx */
  height: auto;
  aspect-ratio: 380/480; /* 保持图片原有比例 */
  top: 50%;
  left: 50%;
  transform: translate(-50%, -55%);
  z-index: 1;
  mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
  -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 95%);
  filter: drop-shadow(0 0 20rpx rgba(76, 201, 240, 0.3));
}

/* 所有环形元素强制正圆 */
.hud-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: 2;
  border-radius: 50%; /* 圆角50%+1:1宽高比=正圆 */
  pointer-events: none;
  aspect-ratio: 1/1;
}

.hud-ring-ticks {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx dashed rgba(76, 201, 240, 0.3);
  box-sizing: border-box;
  animation: spin-slow 60s linear infinite;
  aspect-ratio: 1/1;
}

.hud-ring-inner {
  position: absolute;
  top: 8%;
  left: 8%;
  width: 84%;
  height: 84%;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: inset 0 0 30rpx rgba(76, 201, 240, 0.1);
  aspect-ratio: 1/1;
}

.hud-arc-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-shadow: 0 10rpx 40rpx rgba(76, 201, 240, 0.2);
  border-bottom: 8rpx solid #06b6d4;
  mask-image: linear-gradient(to bottom, transparent 60%, black 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 60%, black 100%);
  aspect-ratio: 1/1;
}

.hud-text-center {
  position: absolute;
  bottom: 50rpx;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 3;
  width: 80%; /* 相对父容器，适配不同屏幕 */
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-lbl-top {
  font-size: 26rpx;
  color: #a5f3fc;
  letter-spacing: 4rpx;
  text-shadow: 0 0 10rpx rgba(6, 182, 212, 0.8);
  margin-bottom: -10rpx;
}

.hud-score-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 10rpx 0 0;
}

.hud-score-num {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: 96rpx;
  background: linear-gradient(to bottom, #f59e0b, #d97706);
  -webkit-background-clip: text;
  color: transparent;
  line-height: 1;
  text-shadow: 0 4rpx 10rpx rgba(217, 119, 6, 0.3);
}

.hud-score-unit {
  font-size: 32rpx;
  color: #d97706;
  font-weight: bold;
  margin-left: 4rpx;
}

.hud-lbl-bottom {
  font-size: 22rpx;
  color: #cbd5e1;
  letter-spacing: 6rpx;
  margin-top: 10rpx;
  opacity: 0.8;
  font-weight: 300;
  font-family: monospace;
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* === 网格菜单 === */
.grid-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  z-index: 10;
}

.grid-item {
  width: 48%;
  height: 200rpx;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.1s;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  color: #e2e8f0;
}

.grid-item:active { transform: scale(0.98); }

.grid-item.bg-1,
.grid-item.bg-2,
.grid-item.bg-3,
.grid-item.bg-4 {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
}

.item-content {
  padding: 20rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.grid-title { font-size: 30rpx; font-weight: bold; }
.grid-sub { font-size: 20rpx; color: rgba(255, 255, 255, 0.5); margin-top: 4rpx; }
.grid-icon { font-size: 48rpx; position: absolute; bottom: 10rpx; right: 10rpx; opacity: 0.8; }

/* === 按钮 === */
.action-section {
  width: 100%;
  margin: 40rpx 0;
  display: flex;
  justify-content: center;
}

.action-btn {
  background: linear-gradient(90deg, #c2410c, #d97706);
  color: #fff;
  font-size: 32rpx;
  padding: 0 100rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  box-shadow: 0 0 20rpx rgba(217, 119, 6, 0.4);
  font-weight: bold;
  letter-spacing: 4rpx;
}

/* === 图表区域 === */
.dashboard-section {
  display: flex;
  justify-content: space-between;
  width: 100%;
  transform: translateZ(0); /* 硬件加速 */
}

.dashboard-card {
  width: 48%;
  background: rgba(30, 30, 30, 0.6);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.paper-bg {
  background: #e7e5e4;
  color: #44403c;
}

.paper-bg .val,
.paper-bg .lbl,
.paper-bg .card-title-lg,
.paper-bg .card-title-sub {
  color: #44403c !important;
}

.paper-bg .card-title-sub,
.paper-bg .lbl { opacity: 0.6; }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.card-title-lg { font-size: 32rpx; font-weight: 800; font-family: serif; }
.card-title-sub { font-size: 20rpx; }

/* 图表容器 */
.chart-box {
  width: 100%;
  height: 160rpx;
  position: relative !important; /* 强化相对定位 */
  overflow: hidden;
  z-index: 1;
  box-sizing: border-box;
}

/* ec-canvas核心样式 */
ec-canvas {
  width: 100% !important;
  height: 100% !important;
  position: relative !important; /* 取消fixed */
  display: block !important;
  top: auto !important;
  left: auto !important;
  z-index: 1 !important;
}

/* 强制覆盖ec-canvas内部Canvas样式 */
ec-canvas canvas {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  transform: none !important;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
  padding-top: 10rpx;
}

.footer-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-col .val { font-weight: bold; font-size: 24rpx; }
.footer-col .lbl { font-size: 20rpx; }