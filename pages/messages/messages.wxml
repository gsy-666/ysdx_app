<view class="container">
  <!-- Calendar Section -->
  <view class="calendar-wrapper">
    <view class="calendar-header">
      <view class="change-btn" bindtap="changeMonth" data-type="prev">◀</view>
      <view class="cur-month">{{currentYear}}年{{currentMonth}}月</view>
      <view class="change-btn" bindtap="changeMonth" data-type="next">▶</view>
    </view>

    <view class="calendar-body">
      <view class="week-row">
        <block wx:for="{{weeks}}" wx:key="*this">
          <view class="week-item">{{item}}</view>
        </block>
      </view>
      <view class="calendar-grid">
        <block wx:for="{{calendarDays}}" wx:key="index">
          <view
            class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.dateStr === selectedDate ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
            bindtap="selectDate" data-date="{{item.dateStr}}">
            <view class="day-num">{{item.day}}</view>
            <view class="term-text" wx:if="{{item.termName}}">{{item.termName}}</view>
            <view class="term-dot" wx:if="{{item.termName}}"></view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- Solar Term Info Card -->
  <view class="term-card" wx:if="{{selectedTerm}}" animation="{{slideAnimation}}" bindtap="hideTermCard">
    <view class="term-card-header">
      <view class="term-icon">🌿</view>
      <view class="term-name">{{selectedTerm.name}}</view>
      <view class="term-date">{{selectedTerm.dateStr}}</view>
    </view>
    <view class="term-content">
      <text class="term-label">注意事项：</text>
      <text>{{selectedTerm.info}}</text>
    </view>
  </view>

  <view class="message-list">
    <!-- AI Doctor Chat -->
    <view class="message-item" bindtap="goToChat" data-type="ai" hover-class="message-item-hover">
      <view class="avatar-box">
        <image class="avatar" src="/static/doctor_origin.png" mode="aspectFill"></image>
        <view class="badge" wx:if="{{aiUnread > 0}}">{{aiUnread}}</view>
      </view>
      <view class="content-box">
        <view class="top-row">
          <text class="title">AI 健康助手</text>
          <text class="time">{{lastAiTime}}</text>
        </view>
        <view class="bottom-row">
          <text class="desc">点击这里开始咨询 AI 医生...</text>
        </view>
      </view>
    </view>

    <!-- System Notification -->
    <view class="message-item" bindtap="goToSystem" data-type="system" hover-class="message-item-hover">
      <view class="avatar-box">
        <image class="avatar" src="/static/message_active.png" mode="aspectFill"></image>
      </view>
      <view class="content-box">
        <view class="top-row">
          <text class="title">系统通知</text>
          <text class="time">刚刚</text>
        </view>
        <view class="bottom-row">
          <text class="desc">欢迎使用炎黄济世综合管理平台！</text>
        </view>
      </view>
    </view>
  </view>
</view>