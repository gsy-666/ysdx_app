.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  display: flex;
  flex-direction: column;
}

/* Calendar Styles */
.calendar-wrapper {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.cur-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.change-btn {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 20rpx;
}

.week-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 10rpx;
  border-bottom: 1px solid #f0f0f0;
  padding-bottom: 10rpx;
}

.week-item {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  margin-bottom: 10rpx;
}

.day-num {
  font-size: 30rpx;
  color: #333;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 50%;
}

.day-cell.today .day-num {
  background-color: #e6f3ff;
  color: #409EFF;
}

.day-cell.selected .day-num {
  background-color: #409EFF;
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(64, 158, 255, 0.4);
}

.day-cell.other-month .day-num {
  color: #ccc;
}

.term-text {
  font-size: 20rpx;
  color: #409EFF;
  margin-top: -6rpx;
  height: 24rpx;
  line-height: 24rpx;
}

.term-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #409EFF;
  position: absolute;
  bottom: 10rpx;
}

/* Solar Term Card */
.term-card {
  margin: 0 20rpx 20rpx;
  background: linear-gradient(135deg, #e6f3ff 0%, #ffffff 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1px solid #d1e9ff;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.1);
}

.term-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.term-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.term-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #409EFF;
}

.term-date {
  font-size: 24rpx;
  color: #666;
  margin-left: auto;
}

.term-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.term-label {
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.message-list {
  background-color: #ffffff;
  padding-top: 20rpx;
  flex: 1;
}

.message-item {
  display: flex;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  align-items: center;
  background: #fff;
  transition: background-color 0.2s;
}

.message-item-hover {
  background-color: #f9f9f9;
}

.avatar-box {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background-color: #eee;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
}

.content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.top-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.bottom-row {
  display: flex;
}

.desc {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 500rpx;
}