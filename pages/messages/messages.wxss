.container {
  height: 100vh;
  background-color: #f7f8fa;
}

.message-list {
  background-color: #ffffff;
  padding-top: 20rpx;
}

.message-item {
  display: flex;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5; 
  align-items: center;
  background: #fff;
  transition: background-color 0.2s;
}

.message-item-hover {
  background-color: #f9f9f9;
}

.avatar-box {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background-color: #eee;
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 0 8rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 14rpx;
}

.content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.top-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.bottom-row {
  display: flex;
}

.desc {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 500rpx;
}