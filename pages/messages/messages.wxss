/* pages/messages/messages.wxss */
page { background-color: #F0F4F7; }

/* Calendar Wrapper */
.calendar-wrapper {
  background: #FFFFFF;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 58, 86, 0.05);
}
.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.change-btn {
  font-size: 32rpx;
  color: #2F80ED;
  padding: 10rpx 20rpx;
}
.cur-month {
  font-size: 32rpx;
  font-weight: bold;
  color: #1F3A56;
}
.week-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 10rpx;
}
.week-item {
  font-size: 24rpx;
  color: #999;
  width: 14.28%;
  text-align: center;
}
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}
.day-cell {
  width: 14.28%;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 10rpx;
}
.day-num { font-size: 28rpx; color: #333; }
.other-month .day-num { color: #CCC; }
.term-text { font-size: 18rpx; color: #2F80ED; margin-top: 2rpx; }
.term-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF5A5F;
  border-radius: 50%;
  position: absolute;
  bottom: 6rpx;
}
.day-cell.today {
  background: #EBF5FF;
}
.day-cell.selected {
  background: #2F80ED;
}
.day-cell.selected .day-num, 
.day-cell.selected .term-text {
  color: #FFFFFF;
}

/* Term Info Card */
.term-card {
  margin: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  border-left: 8rpx solid #2F80ED;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.term-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.term-icon { font-size: 40rpx; margin-right: 20rpx; }
.term-name { font-size: 32rpx; font-weight: bold; color: #1F3A56; margin-right: 20rpx; }
.term-date { font-size: 24rpx; color: #64748B; }
.term-content { font-size: 26rpx; color: #333; line-height: 1.5; }
.term-label { font-weight: bold; color: #333; }

/* Message List */
.message-list { padding: 20rpx; }
.message-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  margin-bottom: 20rpx;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(31, 58, 86, 0.05);
}
.avatar-box {
  position: relative;
  margin-right: 24rpx;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #F0F4F7;
  border: 1px solid #E6EEF5;
}
.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #FF5A5F;
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
}
.content-box { flex: 1; }
.top-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.title { font-size: 30rpx; font-weight: bold; color: #1F3A56; }
.time { font-size: 22rpx; color: #999; }
.bottom-row { display: flex; }
.desc {
  font-size: 26rpx;
  color: #64748B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 480rpx;
}
