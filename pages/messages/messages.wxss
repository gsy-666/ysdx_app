/* pages/messages/messages.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  display: flex;
  flex-direction: column;
}

/* Calendar Styles - 科技风改造 */
.calendar-wrapper {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid var(--border-color);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.cur-month {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 2rpx;
  text-shadow: 0 0 5rpx var(--primary-color);
}

.change-btn {
  color: var(--text-sub);
  padding: 10rpx 20rpx;
}

/* Calendar Body & Grid */
.calendar-body {
  /* No special styles needed */
}

.week-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 10rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.week-item {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: 14.28%;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  position: relative;
  padding-top: 10rpx;
}

.day-num {
  font-size: 28rpx;
  color: var(--text-main);
  z-index: 2;
  margin-bottom: 4rpx;
}

.other-month .day-num {
  color: rgba(255, 255, 255, 0.2);
}

/* Solar Term Text */
.term-text {
  font-size: 18rpx;
  color: var(--primary-color);
  opacity: 0.8;
}

/* Active Day Highlight */
.day-cell.selected .day-num {
  background-color: var(--primary-color);
  color: #fff;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  box-shadow: 0 0 10rpx var(--primary-color);
}

.day-cell.today .day-num {
  border: 1rpx solid var(--primary-color);
  border-radius: 50%;
  width: 50rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
}

/* Solar Term Info Card */
.term-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: rgba(22, 33, 62, 0.95);
  backdrop-filter: blur(10px);
  border: 1rpx solid var(--primary-color);
  border-radius: 16rpx;
  padding: 40rpx;
  z-index: 100;
  box-shadow: 0 0 30rpx rgba(76, 201, 240, 0.3);
}

.term-card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-bottom: 20rpx;
}

.term-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.term-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.term-date {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
}

.term-content {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
}

.term-label {
  color: var(--primary-color);
  margin-bottom: 10rpx;
  display: block;
}

/* Message List */
.message-list {
  padding: 20rpx;
}

.message-item {
  display: flex;
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.message-item-hover {
  background: rgba(76, 201, 240, 0.1);
}

.avatar-box {
  position: relative;
  margin-right: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid var(--border-color);
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background-color: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 20rpx;
  box-shadow: 0 0 5rpx #ff4d4f;
}

.content-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.top-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.time {
  font-size: 22rpx;
  color: var(--text-sub);
}

.desc {
  font-size: 26rpx;
  color: var(--text-sub);
  opacity: 0.8;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 450rpx;
}
