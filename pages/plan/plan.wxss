/* pages/plan/plan.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

/* 头部背景 - 科技深蓝 */
.header-bg {
  background: linear-gradient(135deg, rgba(22, 33, 62, 0.95), rgba(11, 17, 32, 0.95));
  padding: 40rpx 40rpx 100rpx 40rpx;
  color: var(--text-main);
  border-bottom: 1px solid var(--border-color);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.join-btn {
  font-size: 26rpx;
  background: rgba(76, 201, 240, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--primary-color);
  letter-spacing: 2rpx;
  color: var(--primary-color);
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.st-item {
  text-align: center;
}

.st-item .val {
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  color: var(--primary-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.st-item .lbl {
  font-size: 24rpx;
  opacity: 0.8;
  letter-spacing: 2rpx;
  color: var(--text-sub);
}

/* Card Common - 玻璃拟态 */
.card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid var(--border-color);
}

.overlap-card {
  margin-top: -60rpx;
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
  border-left: 8rpx solid var(--primary-color);
  padding-left: 20rpx;
  color: var(--text-main);
  letter-spacing: 3rpx;
  text-shadow: 0 0 3rpx var(--primary-color);
}

.tools-grid {
  display: flex;
  justify-content: space-around;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-color);
  background-color: rgba(76, 201, 240, 0.1);
  padding: 10rpx;
  box-sizing: border-box;
}

.tool-item text {
  font-size: 28rpx;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

/* Metrics Grid */
.metrics-area {
  display: flex;
  flex-wrap: wrap;
  padding: 0 15rpx;
}

.metric-card {
  width: 44%;
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  margin: 15rpx 3%;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--border-color);
}

.m-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  color: var(--text-sub);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 圆点配色 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 5rpx rgba(255, 255, 255, 0.5);
}

.bg-red { background: #ff4d4f; box-shadow: 0 0 5rpx #ff4d4f; }
.bg-blue { background: #4cc9f0; box-shadow: 0 0 5rpx #4cc9f0; }
.bg-green { background: #52c41a; box-shadow: 0 0 5rpx #52c41a; }
.bg-yellow { background: #fadb14; box-shadow: 0 0 5rpx #fadb14; }

.m-val {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 3rpx var(--primary-color);
}

.m-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
}
