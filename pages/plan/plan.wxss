/* pages/plan/plan.wxss */
/* Font file missing, removing @font-face to prevent errors */

page {
  background-color: #f9f5f0;
  /* 宣纸浅米黄底，替代原浅灰 */
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "SimSun", serif;
}

/* 头部背景 - 古风渐变替换 */
.header-bg {
  background: linear-gradient(135deg, #8b4513 0%, #a0522d 100%);
  /* 棕红渐变，替代原青绿渐变 */
  padding: 40rpx 40rpx 100rpx 40rpx;
  color: #fff;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 500;
  /* 书法字体不加粗，保留笔锋 */
  letter-spacing: 4rpx;
  /* 加大字间距，仿书法布局 */
}

.join-btn {
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  /* 新增浅边框，强化古风按钮质感 */
  letter-spacing: 2rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.st-item {
  text-align: center;
}

.st-item .val {
  font-size: 40rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.st-item .lbl {
  font-size: 24rpx;
  opacity: 0.8;
  letter-spacing: 2rpx;
}

/* Card Common - 古风改造 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  /* 棕色调阴影，替代原黑色 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
}

.overlap-card {
  margin-top: -60rpx;
}

/* 卡片标题 - 古风配色替换 */
.card-title {
  font-size: 30rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  margin-bottom: 30rpx;
  border-left: 8rpx solid #8b4513;
  /* 棕红左侧边，替代原青绿 */
  padding-left: 20rpx;
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  letter-spacing: 3rpx;
}

.tools-grid {
  display: flex;
  justify-content: space-around;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  /* 新增圆角，贴合古风 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
  background-color: #f5e8d5;
  /* 新增浅米底色，强化古风 */
  padding: 10rpx;
  box-sizing: border-box;
}

.tool-item text {
  font-size: 28rpx;
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  letter-spacing: 2rpx;
}

/* Metrics Grid - 古风改造 */
.metrics-area {
  display: flex;
  flex-wrap: wrap;
  padding: 0 15rpx;
}

.metric-card {
  width: 44%;
  background: #fff;
  margin: 15rpx 3%;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(139, 69, 19, 0.08);
  /* 棕色调阴影，替代原黑色 */
  border: 1rpx solid #d2b48c;
  /* 新增棕木色边框 */
}

.m-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  color: #a0522d;
  /* 浅棕红，替代原深灰 */
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 圆点配色 - 古风适配（调整为中式传统色） */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1rpx solid #d2b48c;
  /* 新增边框，强化古风 */
}

/* 替换为中式传统色，保留区分度 */
.bg-red {
  background: #c41e3a;
  /* 朱红，替代原亮红 */
}

.bg-blue {
  background: #1a5fb4;
  /* 藏青，替代原亮蓝 */
}

.bg-green {
  background: #2e8b57;
  /* 墨绿，替代原亮绿 */
}

.bg-yellow {
  background: #e6c200;
  /* 姜黄，替代原亮黄 */
}

.m-val {
  font-size: 40rpx;
  font-weight: 500;
  /* 书法字体不加粗 */
  color: #8b4513;
  /* 棕红主色，替代原深灰 */
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.m-sub {
  font-size: 24rpx;
  color: #a0522d;
  /* 浅棕红，替代原浅灰 */
  letter-spacing: 1rpx;
}