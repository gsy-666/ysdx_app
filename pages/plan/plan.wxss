/* pages/plan/plan.wxss */
page { background-color: #F0F4F7; }

.header-bg {
    background: #FFFFFF;
    padding: 40rpx;
    padding-bottom: 80rpx;
    border-bottom: 1px solid #F0F4F7;
}
.header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #1F3A56; }

.stats-row { display: flex; justify-content: space-around; }
.st-item { text-align: center; }
.st-item .val { font-size: 40rpx; font-weight: bold; color: #2F80ED; margin-bottom: 6rpx; }
.st-item .lbl { font-size: 24rpx; color: #64748B; }

.card {
    background: #FFFFFF;
    border-radius: 20rpx;
    margin: 0 30rpx 24rpx 30rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(31, 58, 86, 0.05);
}
.overlap-card { margin-top: -50rpx; position: relative; z-index: 10; }
.card-title {
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 24rpx;
    padding-left: 16rpx;
    border-left: 8rpx solid #2F80ED;
    color: #1F3A56;
}

/* Tasks */
.tasks-list { display: flex; flex-direction: column; }
.task-item { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1px solid #F5F7FA; }
.task-item:last-child { border-bottom: none; padding-bottom: 0; }
.task-icon { width: 64rpx; height: 64rpx; margin-right: 20rpx; border-radius: 12rpx; background: #F8FAFC; padding: 10rpx; box-sizing: border-box; }
.task-info { flex: 1; }
.task-name { font-size: 28rpx; color: #333; font-weight: 500; margin-bottom: 4rpx; }
.task-desc { font-size: 22rpx; color: #FF9800; font-weight: 500; }
.task-btn { background: linear-gradient(90deg, #E6F0F9 0%, #E8F2FF 100%); color: #2F80ED; font-size: 24rpx; padding: 12rpx 30rpx; border-radius: 30rpx; font-weight: bold;}
.task-btn.btn-disabled { background: #F1F5F9; color: #A0AEC0; }

/* Leaderboard */
.leaderboard-list { margin-bottom: 20rpx; }
.lb-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1px solid #F8FAFC; }
.lb-item:last-child { border-bottom: none; }
.lb-rank { width: 50rpx; font-size: 32rpx; font-weight: bold; color: #94A3B8; font-style: italic; text-align: center; }
.lb-rank.rank-top { color: #FF9800; font-size: 36rpx; }
.lb-avatar { width: 70rpx; height: 70rpx; border-radius: 50%; margin: 0 24rpx 0 10rpx; background: #E2E8F0; }
.lb-name { flex: 1; font-size: 28rpx; color: #333; font-weight: 500; }
.lb-points { font-size: 30rpx; font-weight: bold; color: #2F80ED; }
.lb-footer { text-align: center; padding-top: 20rpx; border-top: 1px dashed #E2E8F0; }
.lb-reward { font-size: 22rpx; color: #64748B; background: #F4F7FC; padding: 8rpx 20rpx; border-radius: 20rpx; }

.metrics-area { padding: 0 30rpx; display: flex; flex-wrap: wrap; justify-content: space-between; }
.metric-card {
    background: #FFFFFF;
    border-radius: 20rpx;
    width: 48%;
    padding: 24rpx;
    box-sizing: border-box;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(31, 58, 86, 0.05);
}
.m-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.m-head text { font-size: 28rpx; color: #1F3A56; font-weight: 600; }
.m-val { font-size: 36rpx; font-weight: bold; color: #2C3E50; margin-bottom: 4rpx; }
.m-sub { font-size: 20rpx; color: #999; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.bg-red { background: #FF4D4F; }
.bg-blue { background: #1890FF; }
.bg-green { background: #52C41A; }
.bg-yellow { background: #FAAD14; }

/* Plan Banner */
.plan-banner { position: relative; background: linear-gradient(110deg, #F0FBF0 0%, #DBF3FE 45%, #AEE0FE 100%); border: 3rpx solid #FFFFFF; border-radius: 20rpx; margin: 0 30rpx 24rpx 30rpx; padding: 28rpx 32rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 6rpx 16rpx rgba(182, 214, 244, 0.5); overflow: hidden; }
.plan-banner::before { content: ""; position: absolute; bottom: -20rpx; left: 10%; width: 70%; height: 50rpx; border-top: 4rpx solid rgba(255, 255, 255, 0.8); border-radius: 50%; transform: rotate(-5deg); pointer-events: none; }
.plan-banner::after { content: ""; position: absolute; bottom: -30rpx; right: -10%; width: 60%; height: 70rpx; border-top: 6rpx solid rgba(255, 255, 255, 0.5); border-radius: 50%; transform: rotate(10deg); pointer-events: none; }
.plan-banner-left { display: flex; flex-direction: column; position: relative; z-index: 2; }
.plan-banner-title { font-size: 32rpx; font-weight: bold; color: #0C2855; margin-bottom: 12rpx; letter-spacing: 1rpx; }
.plan-banner-desc { font-size: 22rpx; color: #6A8198; font-weight: 400; }       
.plan-banner-btn { position: relative; z-index: 2; font-size: 24rpx; background: linear-gradient(90deg, #44C7FF 0%, #1562FF 100%); padding: 12rpx 32rpx; border-radius: 40rpx; color: #FFFFFF; font-weight: 500; box-shadow: 0 4rpx 10rpx rgba(32, 109, 254, 0.3), 0 0 0 6rpx rgba(255, 255, 255, 0.6); white-space: nowrap; border: none; }
