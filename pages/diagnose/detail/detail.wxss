/* pages/diagnose/detail/detail.wxss */
.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-main);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.card {
  background-color: var(--card-bg);
  backdrop-filter: blur(5px);
  border: 1px solid var(--border-color);
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-shadow: 0 0 5rpx rgba(76, 201, 240, 0.4);
}

/* Menu Card for Emotion */
.menu-card {
  display: flex;
  background: rgba(22, 33, 62, 0.6);
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border-color);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  align-items: center;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  background: rgba(76, 201, 240, 0.1);
  border: 1px solid var(--border-color);
}

.icon-text {
  font-size: 24rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.content {
  flex: 1;
}

.ct-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  color: var(--text-main);
}

.ct-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* Form Styles */
.form-item {
  margin-bottom: 30rpx;
}

.row-space {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 15rpx;
}

.input,
.textarea {
  background-color: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-color);
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  color: var(--text-main);
}

.textarea {
  height: 150rpx;
}

.picker-input {
  background-color: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-color);
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.system-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.system-label {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
}

.system-ctrl {
  display: flex;
  align-items: center;
}

.picker-box {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: var(--primary-color);
  background: rgba(76, 201, 240, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1px solid var(--border-color);
}

.add-btn {
  color: var(--primary-color);
  font-size: 26rpx;
  font-weight: normal;
  text-shadow: 0 0 5rpx var(--primary-color);
}

.med-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.submit-btn {
  background-color: #C19D34;
  color: #fff;
  margin: 40rpx 0;
  border-radius: 40rpx;
}