<!--pages/diagnose/diagnose.wxml-->
<view class="container">
  <!-- 可移动区域：承载人体图和热点 -->
  <movable-area class="panorama-area" scale-area>
    <movable-view class="panorama-view" direction="all" scale="{{true}}" scale-min="1" scale-max="3" scale-value="{{1}}"
      out-of-bounds="{{true}}" damping="20">
      <!-- 内容容器：绑定图片和热点的相对定位 -->
      <view class="content-wrapper">
        <!-- 人体背景图 -->
        <view class="body-anchor-container">
          <image class="body-anchor" src="{{bodyImage}}" mode="widthFix" binderror="onImageError"
            bindload="onImageLoad"></image>
        </view>

        <!-- 器官热点区域 -->
        <block wx:for="{{organNodes}}" wx:key="key">
          <view class="hotspot-area"
            style="left: {{item.position.x}}%; top: {{item.position.y}}%; width: 12%; height: 10%;"
            bindtap="handleNodeClick" data-route="{{item.route}}" hover-class="hotspot-active">
          </view>
        </block>
      </view>
    </movable-view>
  </movable-area>

  <!-- 缩放提示文字 -->
  <view class="zoom-hint">
    <text>双指缩放查看详情</text>
  </view>

  <!-- 悬浮按钮：打开风险分析报告 -->
  <view class="float-btn" bindtap="showRadar">
    <image class="btn-icon" src="../../static/report.svg" mode="aspectFit"></image>
    <text>综合分析</text>
  </view>

  <!-- 风险分析雷达图弹窗 -->
  <view class="radar-modal {{showRadar ? 'show' : ''}}" catchtouchmove="preventTouchMove">
    <view class="radar-mask" bindtap="hideRadar"></view>
    <view class="radar-content">
      <view class="radar-header">
        <text class="radar-title">五脏平衡·健康态势</text>
        <view class="close-btn" bindtap="hideRadar">×</view>
      </view>
      <view class="radar-chart-box">
        <ec-canvas id="mychart-dom-radar" canvas-id="mychart-radar" ec="{{ ec }}"></ec-canvas>
      </view>
      <view class="radar-desc">
        <text class="desc-label">分析结论：</text>
        <text class="desc-text">您的【心脑系统】风险偏高，建议加强日常监测；【肝脏】代谢能力尚可，请继续保持规律作息。</text>
      </view>
    </view>
  </view>
</view>