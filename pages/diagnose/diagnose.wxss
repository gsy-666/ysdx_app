/* pages/diagnose/diagnose.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
}

.card {
  background-color: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 4rpx;
  /* Square style */
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
}

.system-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.system-ctrl {
  display: flex;
  align-items: center;
}

.picker-box {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #409EFF;
  border: 1rpx solid #409EFF;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.picker-input {
  border: 1rpx solid #ddd;
  padding: 10rpx;
  border-radius: 4rpx;
  margin-top: 10rpx;
}

.textarea {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 4rpx;
  padding: 10rpx;
  height: 100rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
}

.add-btn {
  color: #409EFF;
  font-size: 26rpx;
}

.med-item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.input {
  border: 1rpx solid #ddd;
  padding: 10rpx;
  flex: 1;
  border-radius: 4rpx;
}

.empty-tip {
  text-align: center;
  color: #ccc;
  font-size: 24rpx;
  padding: 20rpx;
}

/* Copied from grade.wxss for Emotion Assessment */
.menu-card {
  background: #fdfdfd;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
}

.icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.ct-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.ct-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.submit-btn {
  background-color: #409EFF;
  color: #fff;
  border-radius: 4rpx;
  margin-top: 40rpx;
}