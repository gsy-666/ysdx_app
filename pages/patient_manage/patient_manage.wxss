page {
  background-color: var(--bg-color);
  padding-bottom: 150rpx;
}
.header-bg {
  background: linear-gradient(180deg, #E6F3FB 0%, #F0F4F7 100%);
  height: 200rpx;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 40rpx 30rpx 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.patient-card {
  position: relative;
}
.patient-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-right: 20rpx;
}
.relation {
  font-size: 22rpx;
  background: linear-gradient(90deg, #EBF4FF 0%, #EBF4FF 100%);
  color: var(--primary-color);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}
.patient-info {
  margin-bottom: 12rpx;
}
.info-item {
  font-size: 26rpx;
  color: var(--text-sub);
}
.actions {
  border-top: 1rpx solid #F0F4F7;
  padding-top: 24rpx;
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}
.action-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  border: 2rpx solid var(--primary-color);
}
.bottom-btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 40rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}
.primary-btn {
  background: linear-gradient(90deg, #3B99FC 0%, #1A7DF9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}
