page {
  background-color: var(--bg-color);
}
.header-bg {
  background: linear-gradient(180deg, #E6F3FB 0%, #F0F4F7 100%);
  height: 200rpx;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 40rpx 30rpx 24rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #F0F4F7;
}
.list-item:last-child {
  border-bottom: none;
}
.list-text {
  font-size: 30rpx;
  color: var(--text-main);
  flex: 1;
}
.list-desc {
  font-size: 28rpx;
  color: var(--text-sub);
}
.arrow {
  color: #C0C8D1;
  font-size: 32rpx;
  font-weight: 300;
  margin-left: 20rpx;
}
.logout-area {
  margin-top: 60rpx;
  padding: 0 40rpx;
}
.logout-btn {
  background: #FFFFFF;
  color: #FF5A5F;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 90, 95, 0.08);
}
