<wxs module="utils">
  module.exports.includes = function(arr, item) {
    if (!arr) return false;
    return arr.indexOf(item) > -1;
  }
  module.exports.hasChecked = function(arr) {
    if (!arr) return false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i].checked) return true;
    }
    return false;
  }
</wxs>

<view class="container">
  <view class="steps-box">
    <view class="step active">1. 四诊问卷</view>
  </view>

  <view class="step-content">
    <view class="card wizard-card" wx:if="{{activeSection == 1}}">
      <view class="card-header">
        <text class="card-title">一、生命精神</text>
        <text class="q-progress">{{activeSection}} / 13</text>
      </view>
      <view class="card-body">
        <checkbox-group bindchange="onLifeChange">
          <label class="block-check" wx:for="{{life.items}}" wx:key="label">
            <checkbox value="{{item.label}}" checked="{{utils.includes(life.selected, item.label)}}" /> {{item.value}}
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="card wizard-card" wx:if="{{activeSection == 2}}">
      <view class="card-header">
        <text class="card-title">二、感受（寒热）</text>
        <text class="q-progress">{{activeSection}} / 13</text>
      </view>
      <view class="card-body">
        <view class="q-item" wx:for="{{coldHotItems}}" wx:key="id" wx:for-index="idx">
          <view class="q-row">
            <checkbox checked="{{item.checked}}" bindtap="toggleItem" data-group="coldHotItems" data-index="{{idx}}" />
            <text bindtap="toggleItem" data-group="coldHotItems" data-index="{{idx}}">{{item.name}}</text>
          </view>
          <view class="severity-row" wx:if="{{item.checked}}">
            <text>程度:</text>
            <radio-group bindchange="updateSeverity" data-group="coldHotItems" data-index="{{idx}}" class="mini-radio">
              <label><radio value="1" checked="{{item.severity==1}}" />轻</label>
              <label><radio value="2" checked="{{item.severity==2}}" />中</label>
              <label><radio value="3" checked="{{item.severity==3}}" />重</label>
            </radio-group>
          </view>
        </view>
      </view>
    </view>

    <view class="card wizard-card" wx:if="{{activeSection == 3}}">
      <view class="card-header">
        <text class="card-title">三、汗出</text>
        <text class="q-progress">{{activeSection}} / 13</text>
      </view>
      <view class="card-body">
        <view class="q-item" wx:for="{{sweatItems}}" wx:key="id" wx:for-index="idx">
          <view class="q-row">
            <checkbox checked="{{item.checked}}" bindtap="toggleItem" data-group="sweatItems" data-index="{{idx}}" />
            <text>{{item.name}}</text>
          </view>
          <view class="severity-row" wx:if="{{item.checked}}">
            <radio-group bindchange="updateSeverity" data-group="sweatItems" data-index="{{idx}}" class="mini-radio">
              <label><radio value="1" checked="{{item.severity==1}}" />轻</label>
              <label><radio value="2" checked="{{item.severity==2}}" />中</label>
              <label><radio value="3" checked="{{item.severity==3}}" />重</label>
            </radio-group>
          </view>
        </view>
      </view>
    </view>

    <view class="card wizard-card" wx:if="{{activeSection == 4}}">
      <view class="card-header">
        <text class="card-title">四、疼痛</text>
        <text class="q-progress">{{activeSection}} / 13</text>
      </view>
      <view class="card-body">
        <view wx:for="{{painLocations}}" wx:key="id" wx:for-index="idx" class="pain-block">
          <view class="pain-header">
            <checkbox checked="{{item.checked}}" bindtap="togglePainLoc" data-index="{{idx}}" />
            <text class="pain-title">{{item.name}}</text>
          </view>
          <view class="pain-natures-grid" wx:if="{{item.checked}}">
            <view class="nature-item {{nat.checked ? 'is-checked' : ''}}" wx:for="{{item.natures}}" wx:for-item="nat" wx:for-index="natIdx" wx:key="id">
              <view style="display:flex; align-items:center;">
                <checkbox checked="{{nat.checked}}" bindtap="togglePainNature" data-loc-index="{{idx}}" data-nat-index="{{natIdx}}" />
                <text bindtap="togglePainNature" data-loc-index="{{idx}}" data-nat-index="{{natIdx}}">{{nat.name}}</text>
              </view>
              <view wx:if="{{nat.checked}}" class="severity-mini">
                <radio-group bindchange="updatePainSeverity" data-loc-index="{{idx}}" data-nat-index="{{natIdx}}">
                  <label class="sev-radio"><radio value="1" checked="{{nat.severity==1}}" />轻</label>
                  <label class="sev-radio"><radio value="2" checked="{{nat.severity==2}}" />中</label>
                  <label class="sev-radio"><radio value="3" checked="{{nat.severity==3}}" />重</label>
                </radio-group>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="card wizard-card" wx:if="{{activeSection == 5}}">
      <view class="card-header">
        <text class="card-title">五、头身胸腹</text>
        <text class="q-progress">{{activeSection}} / 13</text>
      </view>
      <view class="card-body">
        <view class="section-subtitle">头部</view>
        <view wx:for="{{headBodyItems.head}}" wx:key="id" class="q-item" wx:for-index="idx">
          <view class="q-row">
            <checkbox checked="{{item.checked}}" bindtap="toggleItem" data-group="headBodyItems.head" data-index="{{idx}}" />
            <text>{{item.name}}</text>
          </view>
          <view class="severity-row" wx:if="{{item.checked}}">
            <radio-group bindchange="updateSeverity" data-group="headBodyItems.head" data-index="{{idx}}" class="mini-radio">
              <label><radio value="1" checked="{{item.severity==1}}" />轻</label>
              <label><radio value="2" checked="{{item.severity==2}}" />中</label>
              <label><radio value="3" checked="{{item.severity==3}}" />重</label>
            </radio-group>
          </view>
        </view>
      </view>
    </view>

    <button wx:if="{{activeSection < 13}}" class="primary-btn" bindtap="nextQuestion">下一题</button>
    <button wx:if="{{activeSection == 13}}" class="primary-btn" bindtap="nextQuestion">提交问卷</button>
  </view>
</view>