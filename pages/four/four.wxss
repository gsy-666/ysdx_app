/* Page Layout */
.container {
  padding: 20rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* Steps Header */
.steps-box {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.step {
  font-size: 28rpx;
  color: #999;
  font-weight: bold;
}

.step.active {
  color: #1aad19;
  font-size: 32rpx;
}

.arrow {
  margin: 0 20rpx;
  color: #ccc;
}

/* Card Style */
.card {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.center-card {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Upload Area */
.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.tongue-img {
  width: 300rpx;
  height: 300rpx;
  border-radius: 10rpx;
}

.analysis-result {
  margin-top: 20rpx;
  background: #eefaee;
  padding: 15rpx;
  border-radius: 8rpx;
  width: 100%;
  text-align: left;
}

.label-title {
  font-weight: bold;
  color: #1aad19;
  margin-right: 10rpx;
}

/* Tabs */
.custom-tabs {
  display: flex;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
}

.tab-item.active {
  background: #1aad19;
  color: white;
  font-weight: bold;
}

/* Form Elements */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  border-left: 8rpx solid #1aad19;
  padding-left: 15rpx;
  margin-bottom: 20rpx;
  color: #333;
}

.section-subtitle,
.sub-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #555;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
}

.mt {
  margin-top: 30rpx;
}

.marks {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  padding: 0 10rpx;
}

.row-select {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 15rpx;
}

.row-select text {
  font-size: 28rpx;
  margin-right: 15rpx;
  width: 80rpx;
}

.mini-radio checkbox,
.mini-radio radio {
  transform: scale(0.7);
}

.mini-radio label {
  font-size: 26rpx;
  margin-right: 15rpx;
}

.primary-btn {
  background: #1aad19;
  color: white;
  border-radius: 50rpx;
  margin-top: 40rpx;
}

.default-btn {
  background: #fff;
  color: #666;
  border-radius: 50rpx;
}

/* Collapse Card */
.collapse-card {
  padding: 0;
  overflow: hidden;
}

.card-header {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.active-badge {
  background: #eefaee;
  color: #1aad19;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.card-body {
  padding: 0 30rpx 30rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Question Items */
.q-item {
  margin-bottom: 20rpx;
  border-bottom: 1rpx dashed #eee;
  padding-bottom: 10rpx;
}

.q-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.q-row checkbox {
  transform: scale(0.8);
  margin-right: 10rpx;
}

.severity-row {
  margin-left: 56rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.block-check {
  display: block;
  margin-bottom: 15rpx;
  font-size: 28rpx;
}

/* Pain Grid */
.pain-block {
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 10rpx;
}

.pain-header {
  background: #fafafa;
  padding: 10rpx;
  display: flex;
  align-items: center;
  font-weight: bold;
}

.pain-title {
  font-size: 28rpx;
  margin-left: 10rpx;
}

.pain-natures-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx;
}

.nature-item {
  width: 48%;
  margin-bottom: 15rpx;
  font-size: 26rpx;
}

.severity-mini text {
  font-size: 20rpx;
  color: #999;
}

.bottom-btns {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 40rpx;
}

.bottom-btns button {
  flex: 1;
}

.severity-mini {
  margin-top: 10rpx;
  margin-left: 48rpx;
  font-size: 24rpx;
  color: #666;
  background: #f8fcf8;
  padding: 8rpx;
  border-radius: 8rpx;
  display: flex;
}

.sev-radio {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
}

.sev-radio radio {
  transform: scale(0.7);
  margin-right: -2rpx;
}


