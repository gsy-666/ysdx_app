/* pages/four/four.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

/* Page Layout */
.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* Steps Header - Neon Style */
.steps-box {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 10rpx rgba(0, 0, 0, 0.3);
}

.step {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 500;
  letter-spacing: 2rpx;
  position: relative;
  transition: all 0.3s;
}

.step.active {
  color: var(--primary-color);
  font-size: 32rpx;
  text-shadow: 0 0 8rpx var(--primary-color);
  font-weight: 600;
}

.arrow {
  margin: 0 20rpx;
  color: var(--border-color);
  font-size: 24rpx;
}

/* Card Style - Glassmorphism */
.card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid var(--border-color);
}

.center-card {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Upload Area */
.upload-area {
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed var(--primary-color);
  background: rgba(76, 201, 240, 0.05);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
  transition: all 0.3s;
}

.upload-area:active {
  background: rgba(76, 201, 240, 0.15);
}

.camera-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
  filter: drop-shadow(0 0 5rpx var(--primary-color));
}

.hint-text {
  font-size: 28rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

/* Image Preview */
.preview-img {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
}

/* Tip Box */
.tip-box {
  margin-top: 30rpx;
  background: rgba(250, 219, 20, 0.05); /* Yellow tint */
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(250, 219, 20, 0.3);
  width: 100%;
  box-sizing: border-box;
}

.tip-title {
  display: block;
  color: #fadb14;
  font-size: 28rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
  text-shadow: 0 0 3rpx #fadb14;
}

.tip-content {
  display: block;
  color: var(--text-sub);
  font-size: 24rpx;
  line-height: 1.5;
}

/* Audio Section (Wen) */
.audio-control {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(76, 201, 240, 0.1);
  border: 2rpx solid var(--primary-color);
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 40rpx 0;
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.2);
}

.mic-icon {
  width: 60rpx;
  height: 60rpx;
}

.recording {
  animation: pulse-glow 1.5s infinite;
  background: rgba(255, 77, 79, 0.1);
  border-color: #ff4d4f;
  box-shadow: 0 0 20rpx rgba(255, 77, 79, 0.4);
}

@keyframes pulse-glow {
  0% { transform: scale(1); box-shadow: 0 0 10rpx rgba(255, 77, 79, 0.3); }
  50% { transform: scale(1.1); box-shadow: 0 0 30rpx rgba(255, 77, 79, 0.6); }
  100% { transform: scale(1); box-shadow: 0 0 10rpx rgba(255, 77, 79, 0.3); }
}

.timer {
  font-size: 40rpx;
  color: var(--primary-color);
  font-family: monospace;
  text-shadow: 0 0 5rpx var(--primary-color);
  margin-bottom: 20rpx;
}

/* Form Styles (Questionnaire) */
.question-group {
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding-bottom: 20rpx;
}

.q-label {
  display: block;
  font-size: 30rpx;
  color: var(--text-main);
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--primary-color);
  padding-left: 16rpx;
}

.options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option-btn {
  padding: 12rpx 30rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--border-color);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: all 0.2s;
}

.option-btn.selected {
  background: rgba(76, 201, 240, 0.2);
  border-color: var(--primary-color);
  color: var(--primary-color);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.2);
}

/* Action Bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(11, 17, 32, 0.95);
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid var(--border-color);
  backdrop-filter: blur(10px);
  z-index: 100;
}

.btn-secondary {
  width: 30% !important;
  background: transparent;
  border: 1rpx solid var(--border-color);
  color: var(--text-sub);
  border-radius: 40rpx;
}

.btn-primary {
  width: 65% !important;
  background: linear-gradient(90deg, #16213e, #4cc9f0);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 15rpx rgba(76, 201, 240, 0.3);
}
