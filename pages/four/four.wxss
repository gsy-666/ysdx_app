/* pages/four/four.wxss */
page {
  background-color: #F4F7F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  padding-bottom: 120rpx;
}

.container {
  padding: 30rpx;
}

/* 高级步骤指示器 */
.steps-box {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(13, 26, 43, 0.04);
  margin-bottom: 30rpx;
}

.step {
  font-size: 30rpx;
  color: #8C99A8;
  font-weight: 500;
  transition: all 0.3s;
}

.step.active {
  color: #1A7DF9;
  font-size: 32rpx;
  font-weight: bold;
}

.arrow {
  margin: 0 30rpx;
  color: #D1D8E0;
  font-size: 24rpx;
  font-weight: 300;
}

/* 高级通用白底卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(13, 26, 43, 0.04);
}

.center-card {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 照片上传区域 - 更加精致 */
.upload-area {
  width: 100%;
  height: 360rpx;
  border: 2rpx dashed #A0CFFB;
  background: #F8FBFE;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  transition: all 0.2s;
}

.upload-area:active {
  background: #F0F7FF;
  border-color: #1A7DF9;
}

.upload-icon {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.upload-area text {
  font-size: 30rpx;
  color: #2F80ED;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.tongue-img {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.analysis-result {
  margin-top: 30rpx;
  background: #F5FAFF;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.label-title {
  font-size: 28rpx;
  color: #6C7A8C;
  margin-right: 16rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #1A7DF9;
}

/* 自定义Tabs */
.custom-tabs {
  display: flex;
  margin-bottom: 24rpx;
  padding: 0 10rpx;
}

.tab-item {
  font-size: 32rpx;
  color: #6C7A8C;
  margin-right: 40rpx;
  padding-bottom: 10rpx;
  position: relative;
  transition: all 0.2s;
}

.tab-item.active {
  color: #213245;
  font-weight: bold;
  font-size: 34rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 6rpx;
  background: linear-gradient(90deg, #3B99FC, #1A7DF9);
  border-radius: 4rpx;
}

/* 表单区域标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 20rpx;
}

.section-title.mt {
  margin-top: 50rpx;
}

/* 进度条文字刻度 */
.marks {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-top: -10rpx;
}

.marks text {
  font-size: 22rpx;
  color: #8C99A8;
}

/* Slider微调间距 */
slider {
  margin: 20rpx 20rpx 30rpx;
}

/* 底部操作按钮栏 */
.action-bar, .primary-btn {
  width: 90% !important;
  height: 96rpx;
  background: linear-gradient(90deg, #3B99FC 0%, #1A7DF9 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 125, 249, 0.3);
  margin: 50rpx auto 0;
  border: none;
}

/* 问卷部分的优雅样式 */
.collapse-card .card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.collapse-card .card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #213245;
}

.collapse-card .arrow {
  color: #C0C8D1;
  font-size: 24rpx;
}

.active-badge {
  font-size: 20rpx;
  background: #EBF4FF;
  color: #1A7DF9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: auto;
  margin-right: 20rpx;
}

.card-body {
  margin-top: 30rpx;
  border-top: 1rpx solid #F0F2F5;
  padding-top: 30rpx;
}

.block-check {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  color: #4A5666;
}

.q-item {
  margin-bottom: 30rpx;
}

.q-row {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #4A5666;
  margin-bottom: 16rpx;
}

.severity-row {
  background: #F8FBFE;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  margin-left: 50rpx;
}

.severity-row text {
  font-size: 26rpx;
  color: #6C7A8C;
  margin-right: 20rpx;
}

.mini-radio {
  display: flex;
  gap: 30rpx;
}

.mini-radio label {
  font-size: 26rpx;
  color: #4A5666;
}
.wizard-card { min-height: 50vh; display: flex; flex-direction: column; }
.wizard-card .card-body { flex: 1; padding-bottom: 20rpx; }
.progress-text { font-size: 24rpx; color: #999; font-weight: normal; float: right; }
.card-header { display: flex; justify-content: space-between; align-items: center; }

/* 优化疼痛部分层级 */
.pain-block {
  margin-bottom: 40rpx;
  background-color: #F8FBFE;
  border-radius: 12rpx;
  padding: 20rpx;
}

.pain-header {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #213245;
  margin-bottom: 20rpx;
  border-bottom: 2rpx dashed #d1d8e0;
  padding-bottom: 16rpx;
}

.pain-title {
  margin-left: 10rpx;
}

.pain-natures-grid {
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
}

.nature-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.nature-item > checkbox {
  margin-right: 12rpx;
}

.nature-item > text {
  font-size: 30rpx;
  color: #4A5666;
}

.severity-mini {
  margin-top: 10rpx;
  margin-left: 50rpx;
  background: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E6EEF5;
  display: flex;
  align-items: center;
}

.sev-radio {
  font-size: 26rpx;
  color: #6C7A8C;
  margin-right: 24rpx;
}
