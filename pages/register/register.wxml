<!--pages/register/register.wxml-->
<view class="container">
  <view class="logo-area">
    <image class="logo-img" src="/static/logo_origin.png" mode="aspectFit"></image>
    <view class="logo-text">欢迎注册</view>
    <view class="slogan">加入炎黄济世，开启健康生活</view>
  </view>

  <view class="form-area">
    <view class="input-group">
      <text class="label">姓名</text>
      <input class="input" type="text" placeholder="请输入姓名" model:value="{{name}}" />
    </view>

    <view class="input-group">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" model:value="{{phone}}" />
    </view>

    <!-- New Health Profile Fields -->
    <view class="input-group">
      <text class="label">性别</text>
      <radio-group class="radio-group" model:value="{{gender}}" style="display:flex;align-items:center;">
        <label style="margin-right:20rpx;">
          <radio value="1" checked="true" />男
        </label>
        <label>
          <radio value="2" />女
        </label>
      </radio-group>
    </view>

    <view class="input-group">
      <text class="label">年龄</text>
      <input class="input" type="number" placeholder="请输入年龄" model:value="{{age}}" />
    </view>

    <view class="input-group">
      <text class="label">身高(cm)</text>
      <input class="input" type="digit" placeholder="请输入身高" model:value="{{height}}" />
    </view>

    <view class="input-group">
      <text class="label">体重(kg)</text>
      <input class="input" type="digit" placeholder="请输入体重" model:value="{{weight}}" />
    </view>

    <view class="input-group">
      <text class="label">密码</text>
      <input class="input" type="password" placeholder="请输入密码" model:value="{{password}}" />
    </view>

    <view class="input-group">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请确认密码" model:value="{{confirmPassword}}" />
    </view>

    <button class="action-btn" bindtap="handleRegister" loading="{{loading}}">立即注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link-text" bindtap="goToLogin">去登录</text>
    </view>
  </view>
</view>