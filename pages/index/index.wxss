/* pages/index/index.wxss */
/* Font file missing, removing @font-face to prevent errors */

/* 全局古风样式重置 */
page {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "SimSun", serif;
  background-color: #f9f5f0;
  /* 浅米黄底，中式宣纸质感 */
}

.home-container {
  padding: 20rpx;
  min-height: 100vh;
  position: relative;
  font-family: inherit;
  background-color: transparent;
  /* 继承全局宣纸底色 */
}

/* 天气组件 - 合并样式+修复语法错误 */
.weather-widget {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.85);
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid #d2b48c;
  display: flex;
  flex-direction: row;
  /* 修复：去掉多余的** */
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(139, 69, 19, 0.1);
  font-size: 20rpx;
  z-index: 100;
  font-family: inherit;
  white-space: nowrap;
  /* 强制不换行 */
}

.weather-location {
  display: flex;
  align-items: center;
  color: #8b4513;
  font-weight: 500;
  margin-right: 4rpx;
}

.location-icon-text {
  font-size: 20rpx;
  margin-right: 2rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  color: #a0522d;
  margin-left: 4rpx;
}

.weather-temp {
  color: #8b4513;
  font-weight: bold;
  font-size: 20rpx;
  margin-right: 2rpx;
}

/* 核心古风 Header（书法字体+中式配色） */
.header {
  margin-bottom: 20rpx;
  padding-top: 60rpx;
  font-family: inherit;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  color: #8b4513;
  letter-spacing: 8rpx;
  line-height: 1.8;
  text-shadow: 0 1rpx 2rpx rgba(139, 69, 19, 0.1);
}

.subtitle {
  font-size: 28rpx;
  color: #a0522d;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
  font-family: inherit;
  line-height: 1.6;
  opacity: 1;
}

/* Banner 区域 - 古风渐变 */
.banner {
  background: linear-gradient(to right, #f5e8d5, #e8d4b8);
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  padding: 30rpx;
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
}

.join-btn {
  background-color: #8b4513;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  padding: 10rpx 30rpx;
  font-family: inherit;
  border: 1rpx solid #a0522d;
  box-shadow: 0 2rpx 6rpx rgba(139, 69, 19, 0.2);
}

.banner-img {
  width: 150rpx;
  height: 150rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
  border-radius: 8rpx;
  border: 1rpx solid #d2b48c;
}

/* 计划推广区 - 古风卡片 */
.plan-promo {
  background-color: #fff;
  margin-top: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
  font-family: inherit;
}

.promo-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #8b4513;
  letter-spacing: 3rpx;
}

.promo-desc {
  font-size: 22rpx;
  color: #a0522d;
  margin-top: 5rpx;
  letter-spacing: 2rpx;
}

.check-btn {
  background-color: #8b4513;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  margin: 0;
  font-family: inherit;
  border: 1rpx solid #a0522d;
  padding: 8rpx 20rpx;
  box-shadow: 0 2rpx 6rpx rgba(139, 69, 19, 0.2);
}

/* 功能网格区 - 古风卡片组 */
.func-grid-top {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.grid-item {
  background-color: #fff;
  width: 48%;
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  position: relative;
  height: 180rpx;
  font-family: inherit;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
  transition: all 0.2s ease;
}

.grid-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(139, 69, 19, 0.1);
}

.full-width {
  width: 100%;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #8b4513;
  letter-spacing: 3rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: #a0522d;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

.grid-icon {
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 8rpx;
  background-color: #f5e8d5;
  border: 1rpx solid #d2b48c;
}

/* 科室专区 - 古风横向卷轴 */
.zone-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #8b4513;
  margin: 20rpx 0;
  font-family: inherit;
  letter-spacing: 4rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #d2b48c;
}

.dept-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.dept-card {
  display: inline-block;
  background-color: #fff;
  width: 250rpx;
  height: 200rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  padding: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
  position: relative;
  font-family: inherit;
  box-shadow: 0 4rpx 10rpx rgba(139, 69, 19, 0.08);
}

.dept-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #8b4513;
  letter-spacing: 3rpx;
}

.dept-desc {
  font-size: 20rpx;
  color: #a0522d;
  margin-top: 10rpx;
  white-space: normal;
  letter-spacing: 2rpx;
}

.dept-icon {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: #f5e8d5;
  border-radius: 8rpx;
  border: 1rpx solid #d2b48c;
}

/* 底部导航 - 古风样式 */
.edu-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-bottom: 30rpx;
  font-family: inherit;
  padding-top: 20rpx;
  border-top: 1rpx solid #d2b48c;
}

.edu-nav text {
  color: #a0522d;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.edu-nav text.active {
  color: #8b4513;
  font-weight: 500;
  font-size: 28rpx;
  letter-spacing: 3rpx;
}

/* 医生端样式 - 同步古风适配 */
.doctor-header {
  margin-bottom: 30rpx;
  font-family: inherit;
  text-align: center;
}

.doctor-header .title {
  color: #8b4513;
  letter-spacing: 8rpx;
}

.doctor-header .subtitle {
  color: #a0522d;
  letter-spacing: 4rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.stat-card {
  background: #fff;
  width: 48%;
  padding: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
  font-family: inherit;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #a0522d;
  letter-spacing: 2rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  font-family: inherit;
  color: #8b4513;
  letter-spacing: 2rpx;
}

.section-title .more {
  font-size: 24rpx;
  color: #a0522d;
  letter-spacing: 2rpx;
}

.patient-list {
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #d2b48c;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(139, 69, 19, 0.08);
}

.patient-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5e8d5;
  font-family: inherit;
}

.patient-item:last-child {
  border-bottom: none;
}

.patient-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #f5e8d5;
  border: 1rpx solid #d2b48c;
  margin-right: 20rpx;
}

.patient-info {
  flex: 1;
}

.patient-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #8b4513;
  letter-spacing: 2rpx;
}

.patient-phone {
  font-size: 24rpx;
  color: #a0522d;
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

.patient-status {
  font-size: 24rpx;
  color: #8b4513;
  background: #f5e8d5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d2b48c;
  font-family: inherit;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #a0522d;
  font-size: 26rpx;
  font-family: inherit;
  letter-spacing: 3rpx;
}