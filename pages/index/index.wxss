page {
  background: #F4F7FC;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.home-container {
  position: relative;
  min-height: 100vh;
  padding: 0 30rpx 40rpx;
  overflow: hidden;
}

.page-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: -1;
}

.weather-widget {
  position: absolute;
  top: 100rpx;
  right: 30rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(10px);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #555;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.location-icon {
  color: #FF4D4F;
  margin-right: 8rpx;
}

.header-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  margin-bottom: 40rpx;
}

.main-logo {
  width: 260rpx;
  margin-bottom: 10rpx;
  mix-blend-mode: multiply;
}

.main-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1E90FF;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(30, 144, 255, 0.2);
}

.sub-title {
  font-size: 24rpx;
  color: #586C85;
}

.record-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.date-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.date-text {
  font-weight: 500;
}

.date-divider {
  margin: 0 16rpx;
  color: #EEE;
  font-size: 20rpx;
}

.lunar-text {
  color: #586C85;
  font-size: 26rpx;
}

.view-all {
  font-size: 26rpx;
  color: #2B73AF;
}

.record-data {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.data-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #000;
  margin-bottom: 8rpx;
  display: flex;
  align-items: baseline;
}

.data-unit {
  font-size: 24rpx;
  font-weight: normal;
  color: #999;
  margin-left: 4rpx;
}

.data-label {
  font-size: 24rpx;
  color: #999;
}

.data-divider {
  width: 2rpx;
  height: 60rpx;
  background: #F0F0F0;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.menu-item {
  width: 48%;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  position: relative;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.menu-card-1 {
  background: linear-gradient(135deg, #F5FAFF 0%, #FFFFFF 100%);
  border: 1px solid rgba(135, 206, 250, 0.2);
}

.menu-card-2 {
  background: linear-gradient(135deg, #FFF9F9 0%, #FFFFFF 100%);
  border: 1px solid rgba(255, 182, 193, 0.2);
}

.menu-card-3 {
  background: linear-gradient(135deg, #F5FFFF 0%, #FFFFFF 100%);
  border: 1px solid rgba(175, 238, 238, 0.2);
}

.menu-card-4 {
  background: linear-gradient(135deg, #FFFBF5 0%, #FFFFFF 100%);
  border: 1px solid rgba(255, 228, 181, 0.2);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
}

.arrow-icon {
  position: absolute;
  top: 30rpx;
  right: 24rpx;
  color: #DDD;
  font-size: 28rpx;
  font-weight: bold;
}

.menu-text-content {
  margin-top: auto;
}

.menu-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
}
