/* pages/index/index.wxss */
.home-container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  position: relative;
}

/* 天气组件 - 提升对比度 */
.weather-widget {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #fff;
  /* 实色白背景，提升文字对比度 */
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  font-size: 24rpx;
  z-index: 100;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.weather-location {
  display: flex;
  align-items: center;
  color: #1a1a1a;
  /* 深灰黑，清晰醒目 */
  font-weight: 500;
}

.location-icon-text {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  color: #555555;
  /* 中灰，清晰不暗淡 */
}

.weather-temp {
  margin-right: 10rpx;
  color: #409EFF;
  font-weight: bold;
  font-size: 26rpx;
  /* 温度数字放大，更易读 */
}

/* 古风 Header + 高对比度 */
.header {
  margin-bottom: 20rpx;
  padding-top: 60rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  /* 适度加粗，提升辨识度 */
  color: #1a1a1a;
  /* 深灰黑，替代棕褐色，更清晰 */
  letter-spacing: 4rpx;
  /* 适度减少字间距，避免过疏看不清 */
  line-height: 1.6;
  text-shadow: none;
  /* 去掉阴影，避免模糊 */
}

.subtitle {
  font-size: 26rpx;
  color: #555555;
  /* 中灰，替代棕灰色 */
  margin-top: 12rpx;
  letter-spacing: 2rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
  line-height: 1.5;
  opacity: 1;
  /* 取消透光度，提升清晰度 */
}

/* Banner 区域 */
.banner {
  background-color: #e6f3ff;
  border-radius: 4rpx;
  padding: 30rpx;
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
}

.join-btn {
  background-color: #409EFF;
  color: #fff;
  font-size: 24rpx;
  border-radius: 4rpx;
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  padding: 10rpx 30rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.banner-img {
  width: 150rpx;
  height: 150rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
}

/* 计划推广区 - 高对比度 */
.plan-promo {
  background-color: #fff;
  margin-top: 20rpx;
  border-radius: 4rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.promo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.promo-desc {
  font-size: 22rpx;
  color: #555555;
  margin-top: 5rpx;
  letter-spacing: 1rpx;
}

.check-btn {
  background-color: #409EFF;
  color: #fff;
  font-size: 22rpx;
  border-radius: 4rpx;
  margin: 0;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

/* 功能网格区 - 高对比度 */
.func-grid-top {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.grid-item {
  background-color: #fff;
  width: 48%;
  border-radius: 4rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  position: relative;
  height: 180rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.full-width {
  width: 100%;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: #555555;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.grid-icon {
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 0;
  background-color: #eee;
}

/* 科室专区 - 高对比度 */
.zone-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin: 20rpx 0;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
  letter-spacing: 3rpx;
}

.dept-scroll {
  white-space: nowrap;
}

.dept-card {
  display: inline-block;
  background-color: #fff;
  width: 250rpx;
  height: 200rpx;
  margin-right: 20rpx;
  border-radius: 4rpx;
  padding: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
  position: relative;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.dept-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.dept-desc {
  font-size: 20rpx;
  color: #555555;
  margin-top: 10rpx;
  white-space: normal;
  letter-spacing: 1rpx;
}

.dept-icon {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: #eee;
  border-radius: 0;
}

/* 底部导航 - 高对比度 */
.edu-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-bottom: 30rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.edu-nav text {
  color: #555555;
  font-size: 26rpx;
  letter-spacing: 1rpx;
}

.edu-nav text.active {
  color: #1a1a1a;
  font-weight: 600;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 医生端样式 - 高对比度 */
.doctor-header {
  margin-bottom: 30rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.doctor-header .title {
  color: #1a1a1a;
  letter-spacing: 4rpx;
}

.doctor-header .subtitle {
  color: #555555;
  letter-spacing: 2rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.stat-card {
  background: #fff;
  width: 48%;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #409EFF;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #555555;
  letter-spacing: 1rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.section-title .more {
  font-size: 24rpx;
  color: #555555;
  letter-spacing: 1rpx;
}

.patient-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.patient-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.patient-item:last-child {
  border-bottom: none;
}

.patient-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #eee;
  margin-right: 20rpx;
}

.patient-info {
  flex: 1;
}

.patient-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.patient-phone {
  font-size: 24rpx;
  color: #555555;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.patient-status {
  font-size: 24rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 1rpx solid #b7eb8f;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #555555;
  font-size: 26rpx;
  font-family: "STKaiti", "KaiTi", "SimSun", serif;
  letter-spacing: 2rpx;
}