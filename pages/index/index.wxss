/* pages/index/index.wxss */
/* Font file missing, removing @font-face to prevent errors */

/* 全局古风样式重置 */
page {
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "SimSun", serif;
  background-color: var(--bg-color);
  /* 科技玄幻深色底 */
}

.home-container {
  padding: 20rpx;
  min-height: 100vh;
  position: relative;
  font-family: inherit;
  background-color: transparent;
}

/* 天气组件 - 科技感半透明 */
.weather-widget {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: var(--card-bg);
  /* 半透明深色卡片 */
  backdrop-filter: blur(8px);
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border-color);
  /* 科技蓝边框 */
  display: flex;
  flex-direction: row;
  align-items: center;
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.2);
  /* 蓝色发光 */
  font-size: 20rpx;
  z-index: 999;
  font-family: inherit;
  white-space: nowrap;
}

.weather-location {
  display: flex !important;
  align-items: center !important;
  margin-right: 4rpx;
}

.location-icon-text {
  font-size: 24rpx !important;
  margin-right: 4rpx;
  display: inline-block;
  opacity: 1 !important;
  color: var(--primary-color) !important;
}

.city-text {
  font-size: 24rpx !important;
  color: var(--primary-color) !important;
  font-weight: bold;
  opacity: 1 !important;
  display: inline-block;
}

.weather-info {
  display: flex !important;
  align-items: center !important;
  margin-left: 4rpx;
}

.weather-temp {
  color: var(--text-main);
  font-weight: bold;
  font-size: 20rpx;
  margin-right: 2rpx;
}

/* 核心Header（科技古风融合） */
.header {
  margin-bottom: 20rpx;
  padding-top: 20rpx;
  font-family: inherit;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: 500;
  color: var(--text-main);
  text-shadow: 0 0 10rpx var(--primary-color);
  /* 文字发光 */
  letter-spacing: 4rpx;
  line-height: 1.6;
}

.logo-area {
  margin-bottom: 20rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.main-logo {
  width: 260rpx;
  height: 260rpx;
  /* mix-blend-mode: multiply;  Removed for dark mode compatibility */
  /* filter: drop-shadow(0 0 15rpx var(--primary-color)); */
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
  font-family: inherit;
  line-height: 1.6;
  opacity: 1;
}

/* Banner 区域 - 科技深色 */
.banner {
  background: linear-gradient(to right, rgba(22, 33, 62, 0.9), rgba(11, 17, 32, 0.9));
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  padding: 30rpx;
  position: relative;
  height: 200rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 0 20rpx rgba(76, 201, 240, 0.15);
  /* 蓝色光晕 */
}

.join-btn {
  background-color: transparent;
  color: var(--primary-color);
  font-size: 24rpx;
  border-radius: 8rpx;
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  padding: 10rpx 30rpx;
  font-family: inherit;
  border: 1rpx solid var(--primary-color);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.3);
  transition: all 0.3s ease;
}

.banner-img {
  width: 150rpx;
  height: 150rpx;
  position: absolute;
  right: 20rpx;
  bottom: 0;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-color);
}

/* 计划推广区 - 深色玻璃质感 */
.plan-promo {
  background-color: var(--card-bg);
  backdrop-filter: blur(5px);
  margin-top: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.3);
  font-family: inherit;
}

.promo-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  letter-spacing: 3rpx;
  text-shadow: 0 0 5rpx var(--primary-color);
}

.promo-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 5rpx;
  letter-spacing: 2rpx;
}

.check-btn {
  background-color: rgba(76, 201, 240, 0.1);
  color: var(--primary-color);
  font-size: 22rpx;
  border-radius: 8rpx;
  margin: 0;
  font-family: inherit;
  border: 1rpx solid var(--primary-color);
  padding: 8rpx 20rpx;
  box-shadow: 0 0 8rpx rgba(76, 201, 240, 0.2);
}

/* 功能网格区 - 古风卡片组 */
.func-grid-top {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.grid-item {
  background-color: var(--card-bg);
  backdrop-filter: blur(5px);
  width: 48%;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  position: relative;
  height: 180rpx;
  font-family: inherit;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.2s ease;
}

.grid-item:active {
  transform: scale(0.98);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.3);
}

.full-width {
  width: 100%;
}

.grid-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  letter-spacing: 3rpx;
  text-shadow: 0 0 3rpx var(--primary-color);
}

.grid-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  letter-spacing: 2rpx;
}

.grid-icon {
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  border-radius: 8rpx;
  /* background-color: #FFF8E7; removed */
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 5rpx rgba(76, 201, 240, 0.4);
}

/* 科室专区 - 科技横向卷轴 */
.zone-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
  margin: 20rpx 0;
  font-family: inherit;
  letter-spacing: 4rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--border-color);
  text-shadow: 0 0 5rpx var(--primary-color);
}

.dept-scroll {
  white-space: nowrap;
  padding: 10rpx 0;
}

.dept-card {
  display: inline-block;
  background-color: var(--card-bg);
  backdrop-filter: blur(5px);
  width: 250rpx;
  height: 200rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  padding: 20rpx;
  box-sizing: border-box;
  vertical-align: top;
  position: relative;
  font-family: inherit;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}

.dept-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 3rpx;
}

.dept-desc {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 10rpx;
  white-space: normal;
  letter-spacing: 2rpx;
}

.dept-icon {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: transparent;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-color);
}

/* 底部导航 - 科技简约 */
.edu-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-bottom: 30rpx;
  font-family: inherit;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.edu-nav text {
  color: var(--text-sub);
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.edu-nav text.active {
  color: var(--primary-color);
  font-weight: 500;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  text-shadow: 0 0 5rpx var(--primary-color);
}

/* 医生端样式 - 同步科技适配 */
.doctor-header {
  margin-bottom: 30rpx;
  font-family: inherit;
  text-align: center;
}

.doctor-header .title {
  color: var(--text-main);
  letter-spacing: 8rpx;
  text-shadow: 0 0 10rpx var(--primary-color);
}

.doctor-header .subtitle {
  color: var(--text-sub);
  letter-spacing: 4rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.stat-card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  width: 48%;
  padding: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  font-family: inherit;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 10rpx;
  text-shadow: 0 0 8rpx var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
  font-family: inherit;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.section-title .more {
  font-size: 24rpx;
  color: var(--text-sub);
  letter-spacing: 2rpx;
}

.patient-list {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.patient-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  font-family: inherit;
}

.patient-item:last-child {
  border-bottom: none;
}

.patient-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid var(--border-color);
  margin-right: 20rpx;
}

.patient-info {
  flex: 1;
}

.patient-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.patient-phone {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

.patient-status {
  font-size: 24rpx;
  color: var(--primary-color);
  background: rgba(76, 201, 240, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--primary-color);
  font-family: inherit;
}

.empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #a0522d;
  font-size: 26rpx;
  font-family: inherit;
  letter-spacing: 3rpx;
}