<!--pages/index/index.wxml-->
<view class="home-container">
  <!-- Background Image -->
  <image class="page-bg-image" src="/static/index_sky.svg" mode="widthFix"></image>

  <!-- Weather -->
  <view class="weather-widget">
    <text class="location-icon">📍</text>
    <text class="weather-text">{{weatherData.city}} {{weatherData.temperature ? weatherData.temperature + '°C' : ''}} {{weatherData.weather}}</text>
  </view>

  <view class="header-container">
    <image class="main-logo" src="/static/logo_origin.png" mode="widthFix"></image>
    <view class="main-title">炎黄济世</view>
    <view class="sub-title">中西医结合的代谢综合管理</view>
  </view>

  <view class="record-card" bindtap="navigateTo" data-path="/pages/health_detail/health_detail">
    <view class="record-header">
      <view class="date-info">
        <text class="date-text">04月02日 周四</text>
        <text class="date-divider">|</text>
        <text class="lunar-text">农历二月15 - 春分养护季</text>
      </view>
      <view class="view-all">查看全部 ></view>
    </view>
    <view class="record-data">
      <view class="data-item">
        <view class="data-value">72<text class="data-unit">kg</text></view>
        <view class="data-label">早起称重</view>
      </view>
      <view class="data-divider"></view>
      <view class="data-item">
        <view class="data-value">5.4</view>
        <view class="data-label">熬夜熬夜</view>
      </view>
      <view class="data-divider"></view>
      <view class="data-item">
        <view class="data-value">118/78<text class="data-unit">mmHg</text></view>
        <view class="data-label">8:00 记录</view>
      </view>
    </view>
  </view>

  <view class="menu-grid">
    <view class="menu-item menu-card-1" bindtap="navigateTo" data-path="/pkg_eval/pages/tcm_assessment/tcm_assessment">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="/static/four_diag.svg" mode="aspectFit"></image>
      </view>
      <view class="arrow-icon">></view>
      <view class="menu-text-content">
        <view class="menu-title">中医状态评估</view>
        <view class="menu-desc">中医辨证与体质测评</view>
      </view>
    </view>
    
    <view class="menu-item menu-card-2" bindtap="navigateTo" data-path="/pkg_eval/pages/diagnose/diagnose">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="/static/report.svg" mode="aspectFit"></image>
      </view>
      <view class="arrow-icon">></view>
      <view class="menu-text-content">
        <view class="menu-title">风险预警</view>
        <view class="menu-desc">多维健康风险预警</view>
      </view>
    </view>
    
    <view class="menu-item menu-card-3" bindtap="navigateTo" data-path="/pages/connect/connect">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="/static/doctor_contact.svg" mode="aspectFit"></image>
      </view>
      <view class="arrow-icon">></view>
      <view class="menu-text-content">
        <view class="menu-title">名医对话</view>
        <view class="menu-desc">AI辅助与专家团队</view>
      </view>
    </view>
    
    <view class="menu-item menu-card-4" bindtap="navigateTo" data-path="/pages/article/article">
      <view class="menu-icon-wrap">
        <image class="menu-icon" src="/static/article.svg" mode="aspectFit"></image>
      </view>
      <view class="arrow-icon">></view>
      <view class="menu-text-content">
        <view class="menu-title">中医科普</view>
        <view class="menu-desc">养生知识与视频</view>
      </view>
    </view>
  </view>
</view>