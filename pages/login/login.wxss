/* pages/login/login.wxss */
.login-container {
  padding: 60rpx;
  background-color: var(--bg-color);
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.logo-area {
  margin-bottom: 80rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-img {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 0 10rpx var(--primary-color));
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
  text-shadow: 0 0 10rpx var(--primary-color);
}

.slogan {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.input {
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--border-color);
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: var(--text-main);
}

.login-btn {
  background-color: var(--primary-color);
  color: #0b1120;
  font-size: 32rpx;
  margin-top: 60rpx;
  font-weight: bold;
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.4);
}

.register-btn {
  margin-top: 30rpx;
  background-color: transparent;
  color: var(--primary-color);
  border: 1px solid var(--primary-color);
  font-size: 32rpx;
}
