/* pages/login/login.wxss */
page {
    background: linear-gradient(180deg, #F0F6FA 0%, #FFFFFF 100%);
}
.login-container {
    padding: 60rpx;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
}
.logo-area {
    margin-bottom: 60rpx;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.logo-img {
    width: 240rpx;
    height: 240rpx;
    margin-bottom: 24rpx;
    border-radius: 0;
}
.logo-text {
    font-size: 44rpx;
    font-weight: bold;
    color: #1F3A56;
    letter-spacing: 2rpx;
    margin-bottom: 16rpx;
}
.slogan {
    font-size: 26rpx;
    color: #586C85;
}

.input-group { margin-bottom: 40rpx; }
.label {
    font-size: 28rpx;
    color: #1F3A56;
    margin-bottom: 12rpx;
    font-weight: 500;
}
.input {
    background: #FFFFFF;
    border: 1px solid #D6E0EB;
    padding: 24rpx;
    border-radius: 12rpx;
    font-size: 30rpx;
    color: #333;
}
.input:focus { border-color: #2F80ED; }

.login-btn {
    background: linear-gradient(90deg, #56CCF2 0%, #2F80ED 100%);
    color: #FFFFFF;
    font-size: 32rpx;
    margin-top: 50rpx;
    font-weight: bold;
    border-radius: 50rpx;
    box-shadow: 0 8rpx 20rpx rgba(47, 128, 237, 0.25);
    border: none;
}
.register-btn {
    margin-top: 30rpx;
    background-color: transparent;
    color: #2F80ED;
    border: 1px solid #2F80ED;
    font-size: 32rpx;
    border-radius: 50rpx;
}
