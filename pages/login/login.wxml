<!--pages/login/login.wxml-->
<view class="login-container">
  <view class="logo-area">
    <view class="logo-text">代榭云医院</view>
    <view class="slogan">为您の身体健康保驾护航</view>
  </view>

  <view class="login-form">
    <view class="input-group">
      <view class="label">手机号</view>
      <input class="input" type="number" placeholder="请输入手机号" model:value="{{phone}}" />
    </view>
    <view class="input-group">
      <view class="label">密码</view>
      <input class="input" type="password" placeholder="请输入密码" model:value="{{password}}" />
    </view>

    <button class="login-btn" bindtap="handleLogin" loading="{{loading}}">登录</button>
    <button class="register-btn" bindtap="goToRegister">注册</button>
  </view>
</view>