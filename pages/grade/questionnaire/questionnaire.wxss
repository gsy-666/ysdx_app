/* pages/grade/questionnaire/questionnaire.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.header {
  margin-bottom: 40rpx;
  padding: 0 10rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  color: var(--primary-color);
  text-shadow: 0 0 8rpx var(--primary-color);
  letter-spacing: 2rpx;
}

.q-item {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.q-text {
  font-size: 30rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
  color: var(--text-main);
  border-left: 6rpx solid var(--primary-color);
  padding-left: 16rpx;
  line-height: 1.4;
}

.opt-group {
  display: flex;
  flex-direction: column;
}

.opt-label {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: var(--text-sub);
  padding: 16rpx;
  border-radius: 8rpx;
  transition: all 0.3s;
  border: 1rpx solid transparent;
}

.opt-label.checked {
  background: rgba(76, 201, 240, 0.1);
  border-color: var(--primary-color);
  color: var(--primary-color);
}

.opt-label radio {
  transform: scale(0.8);
  margin-right: 16rpx;
}

/* Radio Custom Color */
radio .wx-radio-input {
  background: transparent !important;
  border-color: var(--text-sub) !important;
}

radio .wx-radio-input.wx-radio-input-checked {
  background: var(--primary-color) !important;
  border-color: var(--primary-color) !important;
}

.footer-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 40rpx;
  background: rgba(11, 17, 32, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--border-color);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  z-index: 100;
}

.submit-btn {
  background: linear-gradient(90deg, #16213e, #4cc9f0);
  color: #fff;
  width: 80%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 0 15rpx rgba(76, 201, 240, 0.4);
  text-align: center;
  border: none;
}
