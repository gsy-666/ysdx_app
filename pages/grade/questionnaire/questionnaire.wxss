/* pages/grade/questionnaire/questionnaire.wxss */
page {
  background-color: var(--bg-color, #F0F4F7);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.container {
  padding: 30rpx 20rpx;
  background-color: var(--bg-color, #F0F4F7);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  color: var(--primary-color, #3B99FC);
  letter-spacing: 2rpx;
}

.form-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.q-item {
  background: var(--card-bg, #FFFFFF);
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.q-text {
  font-size: 30rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
  color: var(--text-main, #333333);
  border-left: 8rpx solid var(--primary-color, #3B99FC);
  padding-left: 16rpx;
  line-height: 1.5;
}

.opt-group {
  display: flex;
  flex-direction: column;
}

.opt-label {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: var(--text-sub, #666666);
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  transition: all 0.3s;
  background: #F8FAFC;
  border: 1rpx solid transparent;
}

.opt-label:last-child {
  margin-bottom: 0;
}

.opt-label.checked {
  background: rgba(59, 153, 252, 0.05);
  border-color: var(--primary-color, #3B99FC);
  color: var(--primary-color, #3B99FC);
  font-weight: 500;
}

.opt-label radio {
  transform: scale(0.85);
  margin-right: 16rpx;
}

/* Radio Custom Color */
radio .wx-radio-input {
  border-color: #D1D5DB !important;
}

radio .wx-radio-input.wx-radio-input-checked {
  background: var(--primary-color, #3B99FC) !important;
  border-color: var(--primary-color, #3B99FC) !important;
}

.footer-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 40rpx 40rpx 40rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 100;
}

.reset-btn {
  width: 35% !important;
  background: #F1F5F9;
  color: #64748B;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
  font-weight: 500;
}

.reset-btn::after {
  border: none;
}

.submit-btn {
  width: 60% !important;
  background: linear-gradient(135deg, #3B99FC 0%, #0077FF 100%);
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin: 0;
  padding: 0;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(59, 153, 252, 0.3);
}

.submit-btn::after {
  border: none;
}

/* Result Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}
.modal-content {
  background: #fff;
  border-radius: 24rpx;
  width: 600rpx;
  padding: 50rpx 40rpx;
}
.m-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}
.m-row {
  font-size: 30rpx;
  color: #555;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
}
.highlight {
  color: #3B99FC;
  font-weight: bold;
  font-size: 32rpx;
}
.confirm-btn {
  background: linear-gradient(135deg, #3B99FC 0%, #0077FF 100%);
  color: #fff;
  border-radius: 44rpx;
  margin-top: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}
