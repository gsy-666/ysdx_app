/* pages/grade/questionnaire/questionnaire.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
  padding-bottom: 150rpx;
}

.header {
  margin-bottom: 30rpx;
  padding: 0 10rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
}

.q-item {
  background: #fff;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 4rpx;
}

.q-text {
  font-size: 30rpx;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.opt-group {
  display: flex;
  flex-direction: column;
}

.opt-label {
  margin-bottom: 15rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.opt-label radio {
  transform: scale(0.8);
  margin-right: 10rpx;
}

.footer-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.reset-btn {
  width: 40%;
  background: #E6A23C;
  color: #fff;
  font-size: 28rpx;
}

.submit-btn {
  width: 40%;
  background: #67C23A;
  color: #fff;
  font-size: 28rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  background: #fff;
  width: 80%;
  padding: 40rpx;
  border-radius: 4rpx;
}

.m-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.m-row {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 10rpx;
}

.highlight {
  color: #409EFF;
  font-weight: bold;
}

.confirm-btn {
  background: #409EFF;
  color: #fff;
  margin-top: 40rpx;
}