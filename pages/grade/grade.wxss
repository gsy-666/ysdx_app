/* pages/grade/grade.wxss */
page {
  background-color: var(--bg-color);
  font-family: inherit;
}

.container {
  padding: 20rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.header {
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  margin-bottom: 40rpx;
  color: var(--primary-color);
  text-shadow: 0 0 8rpx var(--primary-color);
  letter-spacing: 4rpx;
}

/* Card Style - Glassmorphic */
.menu-card {
  background: var(--card-bg);
  backdrop-filter: blur(5px);
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.4);
  transition: all 0.3s;
}

.menu-card:active {
  background: rgba(76, 201, 240, 0.15);
  transform: scale(0.98);
}

.icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  background: rgba(76, 201, 240, 0.1);
  border: 1rpx solid var(--border-color);
  box-shadow: 0 0 10rpx rgba(76, 201, 240, 0.2);
}

.icon-text {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 500;
  text-shadow: 0 0 3rpx var(--primary-color);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
  color: var(--text-main);
  letter-spacing: 2rpx;
}

.ct-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  letter-spacing: 1rpx;
}
