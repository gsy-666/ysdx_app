page {
  background-color: var(--bg-color);
  padding-bottom: 150rpx;
}
.header-bg {
  background: linear-gradient(180deg, #E6F3FB 0%, #F0F4F7 100%);
  height: 200rpx;
  width: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1;
}
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 30rpx 24rpx;
  padding: 36rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}
.address-card {
  margin-top: 20rpx;
  position: relative;
}
.contact-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-right: 20rpx;
}
.phone {
  font-size: 28rpx;
  color: var(--text-sub);
}
.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
}
.default-tag {
  background: #EBF4FF;
  color: var(--primary-color);
}
.detail-address {
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.5;
  margin-bottom: 24rpx;
}
.actions {
  border-top: 1rpx solid #F0F4F7;
  padding-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}
.action-btn {
  font-size: 24rpx;
  color: var(--text-sub);
  display: flex;
  align-items: center;
}
.icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  margin-top: 60rpx;
}
.empty-img {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}
.bottom-btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx 40rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}
.primary-btn {
  background: linear-gradient(90deg, #3B99FC 0%, #1A7DF9 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
}

