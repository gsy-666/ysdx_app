<view class="container">
  <view class="header-bg"></view>
  
  <view class="address-list">
    <view class="card address-card" wx:for="{{addresses}}" wx:key="index">
      <view class="contact-info">
        <text class="name">{{item.name}}</text>
        <text class="phone">{{item.phone}}</text>
        <text class="tag default-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <view class="detail-address">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</view>
      <view class="actions">
        <view class="action-btn" bindtap="editAddress">
          <image src="/static/edit.svg" class="icon" mode="aspectFit"></image>
          编辑
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:if="{{addresses.length === 0}}">
      <image class="empty-img" src="/static/default_avatar.svg" mode="aspectFit"></image>
      <text class="empty-text">暂无地址信息</text>
    </view>
  </view>

  <view class="bottom-btn-area">
    <button class="primary-btn" bindtap="addAddress">+ 添加新地址</button>
  </view>
</view>